---
// "fragments folio": the subscribe screen. Shown full-screen over the top
// page on a first visit (mode="overlay", once per browser), and as the
// /subscribe/ page (mode="page"). Not in the design handoff: modelled on a
// Substack welcome page, in fragments' type and colours.
import Subscribe from './Subscribe.astro';
import { site } from '../lib/site';
import { settings } from '../lib/settings';
import { leadParagraphs } from '../lib/settings-shared';

interface Props {
  mode: 'overlay' | 'page';
}
const { mode } = Astro.props;
// the lead is the Japanese catch copy and the newsletter line unless set
// (blank lines part paragraphs; their gap is a setting)
const lead = leadParagraphs(settings.welcomeLead || `${site.catchJa.replace(/\s*\/$/, '')}。\n新しい記事を、メールでお届けします。`);
const leadEn = leadParagraphs(settings.welcomeLeadEn || site.catchEn);
---

<div
  class:list={['welcome', `welcome--${mode}`]}
  data-welcome={mode}
  role={mode === 'overlay' ? 'dialog' : undefined}
  aria-modal={mode === 'overlay' ? 'true' : undefined}
  aria-labelledby="welcome-title"
>
  <div class="inner">
    <div class="logo" aria-hidden={mode === 'overlay' ? 'true' : undefined}>{site.name}</div>
    <h1 id="welcome-title" class="title">{settings.welcomeTitle}</h1>
    <hr class="rule" />
    <p class="lead">{lead.map((l) => <span class="para">{l.map((line, i) => (i ? [<br />, line] : line))}</span>)}</p>
    {leadEn.length > 0 && <p class="lead-en" lang="en">{leadEn.map((l) => <span class="para">{l.map((line, i) => (i ? [<br />, line] : line))}</span>)}</p>}
    <div class="form">
      <Subscribe />
    </div>
    {
      mode === 'overlay' ? (
        <button type="button" class="skip" data-welcome-close data-read-ja={settings.welcomeReadJa} data-read-en={settings.welcomeReadEn}>
          No thanks <span aria-hidden="true">→</span>
        </button>
      ) : (
        <a class="skip" href="/">
          {settings.welcomeReadJa}
          {settings.welcomeReadEn && <span class="skip-en">{settings.welcomeReadEn}</span>}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</div>

<style>
  .welcome {
    /* sizes and gaps from 表示設定 → はじめの案内 (defaults as designed) */
    --wl-title: var(--s-wl-title, 32);
    --wl-lead: var(--s-wl-lead, 15);
    --wl-lead-en: var(--s-wl-lead-en, 13);
    --wl-rule: var(--s-wl-rule, 64);
    --wl-gap-title: var(--s-wl-gap-title, 22);
    --wl-gap-rule: var(--s-wl-gap-rule, 22);
    --wl-gap-en: var(--s-wl-gap-en, 6);
    --wl-para: var(--s-wl-para, 1);
    display: flex;
    background: var(--color-bg);
    color: var(--color-text);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* The overlay only appears when the head script sets data-welcome="show"
     (top page, first visit, JavaScript on). */
  .welcome--overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 10;
    transition: opacity 0.4s ease;
  }
  :global(html[data-welcome='show']) .welcome--overlay {
    display: flex;
  }
  .welcome--overlay.is-leaving {
    opacity: 0;
  }
  .welcome--page {
    position: fixed;
    inset: 0;
  }
  .inner {
    margin: auto;
    width: 100%;
    /* wide enough for the leads and form (表示設定 → 説明文と登録欄の幅) */
    max-width: calc(max(520, var(--s-wl-width, 520)) * 1px + 40px);
    padding: 48px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .logo {
    font-family: var(--font-heading);
    /* 表示設定 → はじめの案内 (128px by default, down to half with the screen) */
    font-size: clamp(calc(var(--s-wl-logo, 128) * 0.5px), calc(var(--s-wl-logo, 128) * 11vw / 128), calc(var(--s-wl-logo, 128) * 1px));
    line-height: 1;
  }
  .title {
    margin: clamp(56px, 12vh, 128px) 0 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: calc(var(--wl-title) * 1px);
    line-height: 1.2;
    letter-spacing: normal;
  }
  /* between the title and the lead (表示設定 → はじめの案内: length, 0 = none, and weight) */
  .rule {
    width: min(100%, calc(var(--wl-rule) * 1px));
    /* gaps above and below are settings; no line (length 0), no gaps. The
       lead's own 16px top margin counts in the gap below. */
    margin: calc(min(1, var(--wl-rule)) * var(--wl-gap-title) * 1px) 0
      calc(min(1, var(--wl-rule)) * (var(--wl-gap-rule) - 16) * 1px);
    border: 0;
    border-top: clamp(0px, var(--wl-rule) * 100px, var(--s-wl-rule-w, 1) * 1px) solid var(--color-neutral-700);
  }
  /* justified, the last line flush left; centred as a block */
  .lead {
    width: min(100%, calc(var(--s-wl-width, 520) * 1px));
    text-align: justify;
    text-align-last: left;
    margin: 16px 0 0;
    font-family: var(--font-mincho);
    font-size: calc(var(--wl-lead) * 1px);
    line-height: 1.9;
    color: var(--color-neutral-800);
  }
  .lead .para,
  .lead-en .para {
    display: block;
  }
  /* a blank line in a lead: one line high by default (表示設定 → 説明文の中の空行) */
  .lead .para + .para {
    margin-top: calc(var(--wl-para) * 1.9em);
  }
  .lead-en .para + .para {
    margin-top: calc(var(--wl-para) * 1.75em);
  }
  /* justified like the Japanese, words hyphenated so the spaces stay even */
  .lead-en {
    width: min(100%, calc(var(--s-wl-width, 520) * 1px));
    text-align: justify;
    text-align-last: left;
    hyphens: auto;
    -webkit-hyphens: auto;
    margin: calc(var(--wl-gap-en) * 1px) 0 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: calc(var(--wl-lead-en) * 1px);
    line-height: 1.75;
    color: var(--color-neutral-700);
  }
  .form {
    width: min(100%, calc(var(--s-wl-width, 520) * 1px)); /* as wide as the leads */
    margin-top: 32px;
    text-align: left;
    font-family: var(--font-mincho);
    font-size: 14px;
  }
  .skip {
    margin-top: 28px;
    padding: 8px 4px;
    border: 0;
    background: none;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-neutral-700);
    text-decoration: none;
    cursor: pointer;
  }
  /* phones: their own values (表示設定 → はじめの案内 → スマホ), else the
     PC ones; the logo is the set size at 390px (half the PC size unless set) */
  @media (max-width: 759px) {
    .welcome {
      --wl-title: var(--s-wl-title-sp, var(--s-wl-title, 32));
      --wl-lead: var(--s-wl-lead-sp, var(--s-wl-lead, 15));
      --wl-lead-en: var(--s-wl-lead-en-sp, var(--s-wl-lead-en, 13));
      --wl-rule: var(--s-wl-rule-sp, var(--s-wl-rule, 64));
      --wl-gap-title: var(--s-wl-gap-title-sp, var(--s-wl-gap-title, 22));
      --wl-gap-rule: var(--s-wl-gap-rule-sp, var(--s-wl-gap-rule, 22));
      --wl-gap-en: var(--s-wl-gap-en-sp, var(--s-wl-gap-en, 6));
      --wl-para: var(--s-wl-para-sp, var(--s-wl-para, 1));
      --wl-logo-sp: var(--s-wl-logo-sp, var(--s-wl-logo, 128) / 2);
    }
    .logo {
      font-size: clamp(calc(var(--wl-logo-sp) * 1px), calc(var(--wl-logo-sp) * 11vw / 64), calc(var(--wl-logo-sp) * 2px));
    }
  }
  .skip :global(.skip-en) {
    margin-left: 0.6em;
    margin-right: 0.4em;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.93em;
  }
  .skip:hover {
    color: var(--color-text);
  }
</style>

<script>
  // Overlay: "No thanks", Escape, or a finished subscription close it for
  // good (remembered in localStorage).
  const box = document.querySelector<HTMLElement>('[data-welcome="overlay"]');
  if (box && document.documentElement.dataset.welcome === 'show') {
    const KEY = 'fragments-welcome';
    const close = () => {
      try {
        localStorage.setItem(KEY, 'done');
      } catch {}
      box.classList.add('is-leaving');
      setTimeout(() => delete document.documentElement.dataset.welcome, 400);
      removeEventListener('keydown', onKey);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    };
    addEventListener('keydown', onKey);
    box.querySelector('[data-welcome-close]')?.addEventListener('click', close);
    // once subscribed, don't show again; the button now leads into the site
    new MutationObserver(() => {
      const done = box.querySelector<HTMLElement>('.done');
      if (done && !done.hidden) {
        try {
          localStorage.setItem(KEY, 'done');
        } catch {}
        const skip = box.querySelector<HTMLElement>('[data-welcome-close]');
        if (skip) {
          // "記事を読む Read the articles →", as on /subscribe/
          const en = Object.assign(document.createElement('span'), { className: 'skip-en', textContent: skip.dataset.readEn ?? '' });
          const arrow = Object.assign(document.createElement('span'), { textContent: '→' });
          arrow.setAttribute('aria-hidden', 'true');
          skip.replaceChildren(`${skip.dataset.readJa ?? ''} `, ...(en.textContent ? [en, ' '] : []), arrow);
        }
      }
    }).observe(box, { subtree: true, attributes: true, attributeFilter: ['hidden'] });
  }
</script>
