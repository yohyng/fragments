---
// Article end: subscribe → 前の記事 / 次の記事 → 関連する記事
import Subscribe from './Subscribe.astro';
import { formatDate, type Post } from '../lib/posts';
import { site } from '../lib/site';

interface Props {
  post: Post;
  /** all posts, newest first */
  posts: Post[];
}
const { post, posts } = Astro.props;

// 「前の記事」 is the next older post, 「次の記事」 the next newer one
const i = posts.findIndex((p) => p.slug === post.slug);
const prev = posts[i + 1];
const next = posts[i - 1];
// 関連する記事: same category, newest first
const related = posts.filter((p) => p.category === post.category && p.slug !== post.slug).slice(0, 3);

// share: the services' own share pages (no scripts of theirs on this site)
const url = new URL(`/posts/${post.slug}/`, Astro.site ?? site.url).href;
const text = post.subtitle ? `${post.title} ${post.subtitle}` : post.title;
const e = encodeURIComponent;
const shares = [
  { label: 'X', href: `https://x.com/intent/post?text=${e(text)}&url=${e(url)}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${e(url)}` },
  { label: 'LINE', href: `https://social-plugins.line.me/lineit/share?url=${e(url)}` },
  { label: 'Bluesky', href: `https://bsky.app/intent/compose?text=${e(`${text} ${url}`)}` },
  { label: 'Threads', href: `https://www.threads.net/intent/post?text=${e(`${text} ${url}`)}` },
  { label: 'はてブ', href: `https://b.hatena.ne.jp/entry/${url.replace(/^https:\/\//, 's/').replace(/^http:\/\//, '')}` },
];
---

<div class="end">
<nav class="share" aria-label="この記事をシェア" data-share={url} data-share-text={text}>
  <span class="share-label">Share</span>
  <ul>
    {shares.map((x) => <li><a href={x.href} target="_blank" rel="noopener">{x.label}</a></li>)}
    <li><button type="button" data-copy>リンクをコピー</button></li>
    <li hidden data-native-li><button type="button" data-native>共有…</button></li>
  </ul>
</nav>
<aside class="sub" aria-label="購読">
  <Subscribe />
</aside>
<nav class="pager" aria-label="前後の記事">
  {
    prev && (
      <a class="prev" href={`/posts/${prev.slug}/`} rel="prev">
        <span class="label">前の記事</span>
        <span>{prev.title}</span>
      </a>
    )
  }
  {
    next && (
      <a class="next" href={`/posts/${next.slug}/`} rel="next">
        <span class="label">次の記事</span>
        <span>{next.title}</span>
      </a>
    )
  }
</nav>
{
  related.length > 0 && (
    <nav class="related" aria-label="関連する記事">
      <div class="related-label">関連する記事</div>
      {related.map((r) => (
        <a href={`/posts/${r.slug}/`}>
          <span class="related-title">
            {r.title}
            {r.subtitle && <span class="related-sub">{r.subtitle}</span>}
          </span>
          <span class="related-date">{formatDate(r.date)}</span>
        </a>
      ))}
    </nav>
  )
}
</div>

<style>
  /* Article end: subscribe → prev / next → related (widths follow the body's 34em) */
  .share,
  .sub,
  .pager,
  .related {
    max-width: calc(34 * var(--body-size));
  }
  /* share: a quiet row of the services' names */
  .share {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 72px;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.6;
  }
  .share-label {
    color: var(--color-neutral-700);
    font-style: italic;
  }
  .share ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  /* buttons: a thin frame, the accent on hover */
  .share a,
  .share button {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--color-divider);
    background: none;
    font: inherit;
    line-height: 1.4;
    color: var(--color-text);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .share a:hover,
  .share button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-700);
  }
  .share + .sub {
    margin-top: 40px;
  }
  .sub {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 96px;
    padding: 48px 0 12px;
    border-top: 1px solid var(--color-text);
    font-family: var(--font-mincho);
    font-size: 14px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    margin-top: 40px;
    font-family: var(--font-mincho);
    font-size: 13px;
    line-height: 1.75;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--color-accent-700);
  }
  .pager .next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }
  .pager .label {
    font-family: var(--font-body);
    font-size: 11.5px;
    color: var(--color-neutral-700);
  }
  .related {
    display: flex;
    flex-direction: column;
    margin-top: 48px;
  }
  .related-label {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-neutral-700);
    padding-bottom: 6px;
  }
  .related a {
    display: block;
    padding: 6px 0;
    font-family: var(--font-mincho);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text);
    text-decoration: none;
  }
  .related a:hover {
    color: var(--color-accent-700);
  }
  .related-title {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .related-sub {
    margin-left: 8px;
    color: var(--color-neutral-700);
  }
  .related-date {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-neutral-700);
    font-variant-numeric: tabular-nums;
  }

  /* ── Beside the index (≥1160px): widths follow the body ── */
  @media (min-width: 1160px) {
    .share,
    .sub,
    .pager,
    .related {
      max-width: var(--pc-body); /* Article.astro */
    }
  }

  /* ── Tablet (p6): as wide as the body (Article.astro) ── */
  @media (max-width: 1159px) {
    .share,
    .sub,
    .pager,
    .related {
      max-width: min(calc(34 * var(--tab-size)), 100% - var(--tab-note) - 40px);
    }
    .sub {
      margin-top: 72px;
      padding: 14px 0 12px;
      border-top-color: var(--color-divider);
    }
    .pager {
      font-size: 13.5px;
    }
    .related {
      margin-top: 40px;
    }
  }

  /* ── Phone (p5): stacked, after the notes ── */
  @media (max-width: 759px) {
    .end {
      display: flex;
      flex-direction: column;
      margin-top: 24px;
      font-family: var(--font-mincho);
      font-size: 14px;
      line-height: 1.7;
    }
    .share,
    .sub,
    .pager,
    .related {
      max-width: none;
    }
    .sub {
      margin-top: 0;
      padding: 14px 0 10px;
    }
    .pager {
      display: flex;
      flex-direction: column;
      margin-top: 32px;
      font-size: inherit;
      line-height: inherit;
    }
    .pager a {
      padding: 8px 0;
    }
    .pager .next {
      align-items: stretch;
      text-align: left;
    }
    .pager .label {
      font-size: 11px;
    }
    .related {
      margin-top: 28px;
    }
  }
  /* Wide phone: as wide as the body */
  @media (min-width: 656px) and (max-width: 759px) {
    .end {
      max-width: min(calc(30 * var(--s-body-tab, 15.5) * 1px), 100% - 212px);
    }
  }
</style>

<script>
  // リンクをコピー, and the device's own share sheet where there is one
  const nav = document.querySelector<HTMLElement>('[data-share]');
  if (nav) {
    const url = nav.dataset.share!;
    const copy = nav.querySelector<HTMLButtonElement>('[data-copy]')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copy.textContent = 'コピーしました';
      } catch {
        copy.textContent = url;
      }
      setTimeout(() => (copy.textContent = 'リンクをコピー'), 2000);
    });
    if (navigator.share) {
      nav.querySelector<HTMLElement>('[data-native-li]')!.hidden = false;
      nav.querySelector('[data-native]')!.addEventListener('click', () =>
        navigator.share({ title: document.title, text: nav.dataset.shareText, url }).catch(() => {}),
      );
    }
  }
</script>
