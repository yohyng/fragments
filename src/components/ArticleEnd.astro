---
// Article end: subscribe → 前の記事 / 次の記事 → 関連する記事
import Subscribe from './Subscribe.astro';
import { formatDate, type Post } from '../lib/posts';
import { site } from '../lib/site';
import { shareIcons } from '../lib/share-icons';

interface Props {
  post: Post;
  /** all posts, newest first */
  posts: Post[];
}
const { post, posts } = Astro.props;

// 「前の記事」 is the next older post, 「次の記事」 the next newer one
const i = posts.findIndex((p) => p.slug === post.slug);
const prev = posts[i + 1];
const next = posts[i - 1];
// 関連する記事: same category, newest first
const related = posts.filter((p) => p.category === post.category && p.slug !== post.slug).slice(0, 3);

// share: the services' own share pages (no scripts of theirs on this site)
const url = new URL(`/posts/${post.slug}/`, Astro.site ?? site.url).href;
const text = post.subtitle ? `${post.title} ${post.subtitle}` : post.title;
const e = encodeURIComponent;
const shares: { label: string; icon: string; href: string }[] = [
  { label: 'X', icon: 'x', href: `https://x.com/intent/post?text=${e(text)}&url=${e(url)}` },
  { label: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${e(url)}` },
  { label: 'Threads', icon: 'threads', href: `https://www.threads.net/intent/post?text=${e(`${text} ${url}`)}` },
];
---

<div class="end">
<aside class="sub" aria-label="購読とシェア">
  <Subscribe fit />
  <nav class="share" aria-label="この記事をシェア" data-share={url} data-share-text={text}>
    <ul>
      {
        shares.map((x) => (
          <li>
            <a href={x.href} target="_blank" rel="noopener" aria-label={`${x.label}でシェア`} title={x.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={shareIcons[x.icon]} /></svg>
            </a>
          </li>
        ))
      }
      <li>
        <button type="button" data-copy aria-label="リンクをコピー" title="リンクをコピー">
          <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L11.6 6" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.6-1.6" /></svg>
        </button>
      </li>
      <li hidden data-native-li>
        <button type="button" data-native aria-label="共有" title="共有">
          <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3.5" /><path d="M7.5 8 12 3.5 16.5 8" /><path d="M8 11H5.5v9.5h13V11H16" /></svg>
        </button>
      </li>
    </ul>
    <span class="share-msg" aria-live="polite" data-share-msg></span>
  </nav>
</aside>
<nav class="pager" aria-label="前後の記事">
  {
    prev && (
      <a class="prev" href={`/posts/${prev.slug}/`} rel="prev">
        <span class="label">前の記事</span>
        <span>{prev.title}</span>
      </a>
    )
  }
  {
    next && (
      <a class="next" href={`/posts/${next.slug}/`} rel="next">
        <span class="label">次の記事</span>
        <span>{next.title}</span>
      </a>
    )
  }
</nav>
{
  related.length > 0 && (
    <nav class="related" aria-label="関連する記事">
      <div class="related-label">関連する記事</div>
      {related.map((r) => (
        <a href={`/posts/${r.slug}/`}>
          <span class="related-title">
            {r.title}
            {r.subtitle && <span class="related-sub">{r.subtitle}</span>}
          </span>
          <span class="related-date">{formatDate(r.date)}</span>
        </a>
      ))}
    </nav>
  )
}
</div>

<style>
  /* Article end: subscribe → prev / next → related (widths follow the body's 34em) */
  .sub,
  .pager,
  .related {
    max-width: calc(34 * var(--body-size));
  }
  /* share: icon buttons beside the subscribe form (below it when narrow) */
  .share {
    position: relative;
    font-family: var(--font-body);
    font-size: 13px;
  }
  .share ul {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* the subscribe box takes what the share buttons leave (only a button
     to the subscribe screen when that is too narrow: Subscribe.astro) */
  .sub > :global(.subscribe) {
    flex: 1 1 0;
    min-width: 0;
  }
  .share {
    flex: none;
  }
  /* icon buttons: a thin frame, the accent on hover */
  .share a,
  .share button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px; /* as tall as the email field */
    padding: 0;
    border: 1px solid var(--color-divider);
    background: none;
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .share svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  .share svg.line-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .share-msg {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    white-space: nowrap;
    font-size: 12px;
    color: var(--color-neutral-700);
  }
  .share a:hover,
  .share button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-700);
  }
  /* the subscribe form and the share buttons in one row under one rule */
  .sub {
    display: flex;
    align-items: flex-start; /* the icons level with the field, above the policy line */
    gap: 12px 16px;
    margin-top: 96px;
    padding: 48px 0 12px;
    border-top: 1px solid var(--color-divider);
    font-family: var(--font-mincho);
    font-size: 14px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    margin-top: 40px;
    font-family: var(--font-mincho);
    font-size: 13px;
    line-height: 1.75;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--color-accent-700);
  }
  .pager .next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }
  .pager .label {
    font-family: var(--font-body);
    font-size: 11.5px;
    color: var(--color-neutral-700);
  }
  .related {
    display: flex;
    flex-direction: column;
    margin-top: 48px;
  }
  .related-label {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-neutral-700);
    padding-bottom: 6px;
  }
  .related a {
    display: block;
    padding: 6px 0;
    font-family: var(--font-mincho);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text);
    text-decoration: none;
  }
  .related a:hover {
    color: var(--color-accent-700);
  }
  .related-title {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .related-sub {
    margin-left: 8px;
    color: var(--color-neutral-700);
  }
  .related-date {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-neutral-700);
    font-variant-numeric: tabular-nums;
  }

  /* ── Beside the index (≥1160px): widths follow the body ── */
  @media (min-width: 1160px) {
    .sub,
    .pager,
    .related {
      max-width: var(--pc-body); /* Article.astro */
    }
  }

  /* ── Tablet (p6): as wide as the body (Article.astro) ── */
  @media (max-width: 1159px) {
    .sub,
    .pager,
    .related {
      max-width: min(calc(34 * var(--tab-size)), 100% - var(--tab-note) - 40px);
    }
    .sub {
      margin-top: 72px;
      padding: 14px 0 12px;
      border-top-color: var(--color-divider);
    }
    .pager {
      font-size: 13.5px;
    }
    .related {
      margin-top: 40px;
    }
  }

  /* ── Phone (p5): stacked, after the notes ── */
  @media (max-width: 759px) {
    .end {
      display: flex;
      flex-direction: column;
      margin-top: 24px;
      font-family: var(--font-mincho);
      font-size: 14px;
      line-height: 1.7;
    }
    .sub,
    .pager,
    .related {
      max-width: none;
    }
    .sub {
      margin-top: 0;
      padding: 14px 0 10px;
      column-gap: 8px; /* as between the share buttons */
    }
    .pager {
      display: flex;
      flex-direction: column;
      margin-top: 32px;
      font-size: inherit;
      line-height: inherit;
    }
    .pager a {
      padding: 8px 0;
    }
    .pager .next {
      align-items: stretch;
      text-align: left;
    }
    .pager .label {
      font-size: 11px;
    }
    .related {
      margin-top: 28px;
    }
  }
  /* Wide phone: as wide as the body */
  @media (min-width: 656px) and (max-width: 759px) {
    .end {
      max-width: min(calc(30 * var(--s-body-tab, 15.5) * 1px), 100% - 212px);
    }
  }
</style>

<script>
  // リンクをコピー, and the device's own share sheet where there is one
  const nav = document.querySelector<HTMLElement>('[data-share]');
  if (nav) {
    const url = nav.dataset.share!;
    const copy = nav.querySelector<HTMLButtonElement>('[data-copy]')!;
    const msg = nav.querySelector<HTMLElement>('[data-share-msg]')!;
    let t: ReturnType<typeof setTimeout>;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        msg.textContent = 'リンクをコピーしました';
      } catch {
        msg.textContent = url;
      }
      clearTimeout(t);
      t = setTimeout(() => (msg.textContent = ''), 2500);
    });
    if (navigator.share) {
      nav.querySelector<HTMLElement>('[data-native-li]')!.hidden = false;
      nav.querySelector('[data-native]')!.addEventListener('click', () =>
        navigator.share({ title: document.title, text: nav.dataset.shareText, url }).catch(() => {}),
      );
    }
  }
</script>
