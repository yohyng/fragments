---
import { categories } from '../content.config';
import { formatDate, type Post } from '../lib/posts';
import { site } from '../lib/site';
import { settings } from '../lib/settings';

interface Props {
  posts: Post[];
  /** slug of the article being read */
  current?: string;
}
const { posts, current } = Astro.props;
const LIMIT = settings.pageSize;
const onAbout = Astro.url.pathname.startsWith('/about');
---

<nav class="index" data-scroll data-noscrollbar data-index aria-label="記事索引">
  <a class="site" href="/">{site.name}</a>
  <div class="intro">
    <span class="intro-ja">{site.catchJa}</span>
    <span class="intro-en" lang="en">{site.catchEn}</span>
    <div class="cats">
      {
        ['all', ...categories].map((c) => (
          <button type="button" class:list={['cat', { 'is-active': c === 'all' }]} data-cat={c} aria-pressed={c === 'all' ? 'true' : 'false'}>
            {c}
          </button>
        ))
      }
    </div>
  </div>
  <div class="list">
    {
      posts.map((p, i) => (
        <a
          class:list={['item', { 'is-current': p.slug === current }]}
          href={`/posts/${p.slug}/`}
          data-cat={p.category}
          data-more={i >= LIMIT ? '' : undefined}
          aria-current={p.slug === current ? 'page' : undefined}
        >
          <span class="item-title">
            <span class="item-mark">
              {p.title}
              {p.subtitle && <span class="item-sub">{p.subtitle}</span>}
            </span>
          </span>
          <span class="item-date">{formatDate(p.date)}</span>
        </a>
      ))
    }
  </div>
  {posts.length > LIMIT && <button class="more" type="button" data-step={LIMIT}>さらに読み込む</button>}
  <div class="links">
    <a class:list={['about', { 'is-current': onAbout }]} href="/about/" aria-current={onAbout ? 'page' : undefined}>about<span class="arrow" aria-hidden="true">↗</span></a>
    <a class="subscribe" href="/subscribe/">subscribe<span class="arrow" aria-hidden="true">↗</span></a>
  </div>
  <a class="policy" href="/privacy/">Privacy Policy</a>
  <div class="scroll-foot" aria-hidden="true"></div>
</nav>
<script is:inline>{
  // Runs inline, right after the index, so its state (category, length,
  // scroll) is in place before the first paint and the page transition.
  // Category filter (dims non-matching posts, never hides them) and
  // "さらに読み込む" (20 more per press, after ~600ms of 「読み込み中…」).
  // State lives in sessionStorage so it survives moving between articles,
  // as it would in the single-page prototype.
  const KEY = 'fragments-index';
  const load = () => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) || '{}');
    } catch {
      return {};
    }
  };
  const save = (patch) => {
    try {
      sessionStorage.setItem(KEY, JSON.stringify({ ...load(), ...patch }));
    } catch {}
  };

  const nav = document.currentScript.previousElementSibling;
  if (nav) {
    const cats = [...nav.querySelectorAll('.cat')];
    const items = [...nav.querySelectorAll('.item')];
    const more = nav.querySelector('.more');
    const step = Number(more?.dataset.step ?? 20);
    const state = load();

    const setCat = (cat) => {
      cats.forEach((b) => {
        const on = b.dataset.cat === cat;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      items.forEach((a) => a.classList.toggle('is-dim', cat !== 'all' && a.dataset.cat !== cat));
    };
    const setLimit = (limit) => {
      items.forEach((a, i) => a.toggleAttribute('data-more', i >= limit));
      if (more) more.hidden = limit >= items.length;
    };

    let cat = state.cat && cats.some((b) => b.dataset.cat === state.cat) ? state.cat : 'all';
    // Always list the article being read.
    const cur = items.findIndex((a) => a.classList.contains('is-current'));
    let limit = Math.max(state.limit ?? step, cur >= 0 ? Math.ceil((cur + 1) / step) * step : 0);
    setCat(cat);
    setLimit(limit);
    if (state.scroll) {
      // restoring the position is not the reader scrolling: no thumb flash
      nav.dataset.restoring = '';
      nav.scrollTop = state.scroll;
      requestAnimationFrame(() => requestAnimationFrame(() => delete nav.dataset.restoring));
    }

    cats.forEach((b) =>
      b.addEventListener('click', () => {
        cat = b.dataset.cat;
        setCat(cat);
        save({ cat });
      }),
    );

    let loading = false;
    more?.addEventListener('click', () => {
      if (loading) return;
      loading = true;
      more.textContent = '読み込み中…';
      setTimeout(() => {
        loading = false;
        more.textContent = 'さらに読み込む';
        limit += step;
        setLimit(limit);
        save({ limit });
      }, 600);
    });

    addEventListener('pagehide', () => save({ scroll: nav.scrollTop }));

    // A title too long for its line is cut so that it and its 「…」 fill the
    // line exactly, justified, and every cut title ends at the same right
    // edge (CSS ellipsis cuts at a character, leaving a ragged edge). The
    // CSS ellipsis stays as the fallback without JS.
    const titles = items.map((a) => {
      const t = a.querySelector('.item-title');
      const walk = document.createTreeWalker(t, NodeFilter.SHOW_TEXT);
      const nodes = [];
      while (walk.nextNode()) nodes.push(walk.currentNode);
      const orig = nodes.map((n) => n.data);
      const full = orig.join('').replace(/\s+/g, ' ').trim();
      t.title = full;
      a.setAttribute('aria-label', `${full} ${a.querySelector('.item-date')?.textContent ?? ''}`.trim());
      return { t, nodes, orig, total: orig.reduce((s, x) => s + x.length, 0) };
    });
    const range = document.createRange();
    const fits = (t) => {
      range.selectNodeContents(t);
      return range.getBoundingClientRect().width <= t.clientWidth + 0.1;
    };
    const cutTo = ({ nodes, orig }, k) => {
      let last = -1;
      nodes.forEach((n, i) => {
        const before = orig.slice(0, i).reduce((s, x) => s + x.length, 0);
        const part = orig[i].slice(0, Math.max(0, k - before));
        n.data = part;
        if (part.trim()) last = i;
      });
      if (last >= 0 && k < orig.join('').length) nodes[last].data = nodes[last].data.trimEnd() + '…';
    };
    let fitting = false;
    const fitTitles = () => {
      if (fitting) return;
      fitting = true;
      for (const x of titles) {
        const { t, nodes, orig, total } = x;
        if (!t.clientWidth) continue; // hidden (not loaded yet)
        nodes.forEach((n, i) => (n.data = orig[i]));
        t.classList.remove('is-cut');
        if (fits(t)) continue;
        t.classList.add('is-cut'); // left-aligned while measuring (justify stretches)
        t.style.textAlignLast = 'left';
        let lo = 0;
        let hi = total - 1;
        while (lo < hi) {
          const mid = Math.ceil((lo + hi) / 2);
          cutTo(x, mid);
          if (fits(t)) lo = mid;
          else hi = mid - 1;
        }
        cutTo(x, lo);
        t.style.textAlignLast = '';
      }
      fitting = false;
    };
    fitTitles();
    document.fonts?.ready.then(fitTitles);
    let w = 0;
    new ResizeObserver(() => {
      const list = nav.querySelector('.list');
      const nw = list ? list.clientWidth + ':' + list.querySelectorAll('.item:not([data-more])').length : '';
      if (nw !== w) { w = nw; fitTitles(); }
    }).observe(nav.querySelector('.list') ?? nav);
  }
}
</script>

<style>
  .index {
    height: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-bottom: 96px;
  }
  /* never squeeze a block to fit the column (it scrolls instead) */
  .index > * {
    flex-shrink: 0;
  }
  .site {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-bg);
    font-family: var(--font-heading);
    font-size: calc(var(--s-site-name, 30) * 1px);
    line-height: 1.2;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-neutral-700);
    text-decoration: none;
  }
  .site,
  .site:hover { color: var(--color-text); }
  .intro {
    display: flex;
    flex-direction: column;
    /* gaps: 表示設定 → トップ・記事一覧 (the index's own 22px gap counted in) */
    gap: calc(var(--s-ix-b, 4) * 1px);
    min-height: var(--s-ix-c-minh, 222px);
    box-sizing: border-box;
    padding-top: calc(var(--s-ix-a, 56) * 1px - 22px);
    font-size: 13px;
    line-height: 1.75;
    color: var(--color-neutral-800);
  }
  /* the catch copy justified, the last line flush left (English hyphenated) */
  .intro-ja,
  .intro-en {
    display: block;
    text-align: justify;
    text-align-last: left;
  }
  .intro-en { hyphens: auto; -webkit-hyphens: auto; position: relative; }
  /* a thin, light rule under the catch copy, as wide as the column (like
     the header's), drawn in the gap above the categories (表示設定: its
     distance below the English) */
  .intro-en::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(100% + var(--s-ix-rule-gap, 16) * 1px);
    width: 100%;
    height: 1px;
    background: var(--color-divider);
  }
  .intro-ja { font-family: var(--font-mincho); font-size: calc(var(--s-catch-ja, 13) * 1px); }
  .intro-en { font-family: var(--font-body); font-style: italic; font-size: calc(var(--s-catch-en, 13) * 1px); }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: var(--s-ix-c-pc, auto); /* auto: the list starts level with the article */
    padding-top: 14px;
    font-family: var(--font-body);
  }
  .cat {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text);
    border-bottom: 1px solid transparent;
  }
  .cat.is-active {
    color: var(--color-accent-700);
    border-bottom-color: var(--color-accent);
  }
  .list {
    display: flex;
    flex-direction: column;
    margin-top: calc(var(--s-ix-d, 22) * 1px - 22px);
  }
  .item {
    display: block;
    padding: 3px 0;
    font-size: calc(var(--s-index, 13) * 1px);
    line-height: 1.75;
    text-decoration: none;
    color: var(--color-text);
  }
  .item.is-current,
  .item:hover { color: var(--color-accent-700); }
  .item.is-dim { color: var(--color-neutral-400); }
  .item.is-dim:hover { color: var(--color-accent-700); }
  .item.is-dim .item-sub,
  .item.is-dim .item-date { color: var(--color-neutral-400); }
  /* Without JS every post is listed and there is nothing to load. */
  :global(html.js) .item[data-more],
  :global(html:not(.js)) .more { display: none; }
  .item-title {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-index, var(--font-mincho)); /* 表示設定 → 記事一覧のフォント */
  }
  /* cut by the script: the title and its 「…」 fill the line, justified */
  .item-title.is-cut {
    text-overflow: clip;
    text-align: justify;
    text-align-last: justify;
  }
  /* the article being read, beside the index (≥1160px): its title in the
     accent, underlined in the accent */
  @media (min-width: 1160px) {
    .item.is-current .item-mark {
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.25em;
    }
    .item.is-current .item-sub {
      color: inherit;
    }
  }
  .item-sub {
    margin-left: 8px;
    color: var(--color-neutral-700);
  }
  .item-date {
    display: block;
    font-family: var(--font-body);
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--color-neutral-700);
    font-variant-numeric: tabular-nums;
  }
  .more {
    align-self: stretch;
    text-align: left;
    margin-top: 4px;
    padding: 10px 0 6px;
    border: 0;
    border-top: 1px solid var(--color-divider);
    font-family: var(--font-mincho);
    font-size: 13px;
    color: var(--color-neutral-500);
    background: none;
    cursor: pointer;
  }
  .more:hover { color: var(--color-neutral-700); }
  .links {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mincho);
    font-size: 13px;
    line-height: 1.75;
  }
  .about,
  .subscribe { text-decoration: none; }
  /* a pointer that these lead to a page of their own */
  .arrow {
    margin-left: 0.3em;
    font-size: 0.9em;
  }
  .about,
  .about:hover { color: var(--color-text); }
  .about.is-current { color: var(--color-accent-700); }
  .subscribe,
  .subscribe:hover { color: var(--color-accent-700); }

  /* at the very end, small */
  .policy {
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--color-neutral-700);
    text-decoration-color: var(--color-divider);
  }
  .policy:hover { color: var(--color-accent-700); }

  /* ── Tablet top (p7): 340px column ── */
  @media (max-width: 1159px) {
    /* full screen; the content keeps its 340px column at the left */
    .index {
      padding: 0 calc(100% - 340px - var(--inset-x)) 0 var(--inset-x);
    }
    .site {
      font-size: calc(var(--s-site-name, 30) * 28px / 30); /* 28px by default */
      padding-top: var(--inset-top);
    }
    /* 80px below the links, then the bottom margin strip */
    .scroll-foot { margin-top: calc(80px - 22px); }
    .intro {
      min-height: 0;
    }
    .cats {
      gap: 0 16px;
      margin-top: calc(var(--s-ix-c, 62) * 1px - var(--s-ix-b, 4) * 1px); /* the gap from the English line */
      padding-top: 0;
    }
    /* the categories, list and links are set as on PC (sizes, spacing) */
    .links {
      flex-direction: row;
      gap: 24px;
    }
  }

  /* ── Phone top (p4): one column; categories scroll sideways ── */
  @media (max-width: 759px) {
    .index {
      gap: 20px;
      padding: 0 var(--inset-x);
    }
    /* phone sizes (表示設定 → スマホ), else from the PC ones */
    .site { font-size: calc(var(--s-site-name-sp, var(--s-site-name, 30) * 26 / 30) * 1px); } /* 26px by default */
    .intro-ja { font-size: calc(var(--s-catch-ja-sp, var(--s-catch-ja, 13)) * 1px); }
    .intro-en { font-size: calc(var(--s-catch-en-sp, var(--s-catch-en, 13)) * 1px); }
    .item { font-size: calc(var(--s-index-sp, var(--s-index, 13)) * 1px); }
    .scroll-foot { margin-top: calc(48px - 20px); }
    .intro {
      padding-top: calc(var(--s-ix-a-sp, 40) * 1px - 20px);
      gap: calc(var(--s-ix-b-sp, 4) * 1px);
    }
    .cats {
      flex-wrap: nowrap;
      gap: 0 18px;
      margin-top: calc(var(--s-ix-c-sp, 40) * 1px - var(--s-ix-b-sp, 4) * 1px);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .cats::-webkit-scrollbar { display: none; }
    .cat {
      flex: none;
    }
    .list { margin-top: calc(var(--s-ix-d-sp, 22) * 1px - 20px); }
  }

  /* ── Wider phones, e.g. an unfolded foldable: the phone layout in a
     column of at most 480px at the left (as tablets keep theirs), so the
     lines do not run across the whole screen; narrower phones are not
     affected ── */
  @media (max-width: 759px) {
    .index {
      padding: 0 max(var(--inset-x), 100% - 480px - var(--inset-x)) 0 var(--inset-x);
    }
  }
</style>
