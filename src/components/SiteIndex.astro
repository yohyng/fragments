---
import { categories } from '../content.config';
import { formatDate, type Post } from '../lib/posts';
import { site } from '../lib/site';

interface Props {
  posts: Post[];
  /** slug of the article being read */
  current?: string;
}
const { posts, current } = Astro.props;
const LIMIT = 20;
---

<nav class="index" data-scroll data-noscrollbar data-index aria-label="記事索引">
  <a class="site" href="/">{site.name}</a>
  <div class="intro">
    <span class="intro-ja">{site.catchJa}</span>
    <span class="intro-en">{site.catchEn}</span>
    <div class="cats">
      {
        ['all', ...categories].map((c) => (
          <button type="button" class:list={['cat', { 'is-active': c === 'all' }]} data-cat={c} aria-pressed={c === 'all' ? 'true' : 'false'}>
            {c}
          </button>
        ))
      }
    </div>
  </div>
  <div class="list">
    {
      posts.map((p, i) => (
        <a
          class:list={['item', { 'is-current': p.slug === current }]}
          href={`/posts/${p.slug}/`}
          data-cat={p.category}
          data-more={i >= LIMIT ? '' : undefined}
          aria-current={p.slug === current ? 'page' : undefined}
        >
          <span class="item-title">
            {p.title}
            {p.subtitle && <span class="item-sub">{p.subtitle}</span>}
          </span>
          <span class="item-date">{formatDate(p.date)}</span>
        </a>
      ))
    }
  </div>
  {posts.length > LIMIT && <button class="more" type="button" data-step={LIMIT}>さらに読み込む</button>}
  <div class="links">
    <a class="about" href="/about/">about</a>
    <a class="subscribe" href="/subscribe/">subscribe</a>
  </div>
  <div class="scroll-foot" aria-hidden="true"></div>
</nav>

<style>
  .index {
    height: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-bottom: 96px;
  }
  /* never squeeze a block to fit the column (it scrolls instead) */
  .index > * {
    flex-shrink: 0;
  }
  .site {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-bg);
    font-family: var(--font-heading);
    font-size: 30px;
    line-height: 1.2;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-neutral-700);
    text-decoration: none;
  }
  .site,
  .site:hover { color: var(--color-text); }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 222px;
    box-sizing: border-box;
    padding-top: 34px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--color-neutral-800);
  }
  .intro-ja { font-family: var(--font-mincho); }
  .intro-en { font-family: var(--font-body); font-style: italic; }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: auto;
    padding-top: 14px;
    font-family: var(--font-body);
  }
  .cat {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text);
    border-bottom: 1px solid transparent;
  }
  .cat.is-active {
    color: var(--color-accent-700);
    border-bottom-color: var(--color-accent);
  }
  .list {
    display: flex;
    flex-direction: column;
  }
  .item {
    display: block;
    padding: 3px 0;
    font-size: 13px;
    line-height: 1.75;
    text-decoration: none;
    color: var(--color-text);
  }
  .item.is-current,
  .item:hover { color: var(--color-accent-700); }
  .item.is-dim { color: var(--color-neutral-400); }
  .item.is-dim:hover { color: var(--color-accent-700); }
  .item.is-dim .item-sub,
  .item.is-dim .item-date { color: var(--color-neutral-400); }
  /* Without JS every post is listed and there is nothing to load. */
  :global(html.js) .item[data-more],
  :global(html:not(.js)) .more { display: none; }
  .item-title {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-mincho);
  }
  .item-sub {
    margin-left: 8px;
    color: var(--color-neutral-700);
  }
  .item-date {
    display: block;
    font-family: var(--font-body);
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--color-neutral-700);
    font-variant-numeric: tabular-nums;
  }
  .more {
    align-self: stretch;
    text-align: left;
    margin-top: 4px;
    padding: 10px 0 6px;
    border: 0;
    border-top: 1px solid var(--color-divider);
    font-family: var(--font-mincho);
    font-size: 13px;
    color: var(--color-neutral-500);
    background: none;
    cursor: pointer;
  }
  .more:hover { color: var(--color-neutral-700); }
  .links {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mincho);
    font-size: 13px;
    line-height: 1.75;
  }
  .about,
  .subscribe { text-decoration: none; }
  .about,
  .about:hover { color: var(--color-text); }
  .subscribe,
  .subscribe:hover { color: var(--color-accent-700); }

  /* ── Tablet top (p7): 340px column ── */
  @media (max-width: 1159px) {
    /* full screen; the content keeps its 340px column at the left */
    .index {
      padding: 0 calc(100% - 340px - var(--inset-x)) 0 var(--inset-x);
    }
    .site {
      font-size: 28px;
      padding-top: var(--inset-top);
    }
    /* 80px below the links, then the bottom margin strip */
    .scroll-foot { margin-top: calc(80px - 22px); }
    .intro {
      min-height: 0;
    }
    .cats {
      gap: 0 16px;
      margin-top: 58px;
      padding-top: 0;
    }
    .cat {
      font-size: 14px;
      padding: 10px 0 6px;
    }
    .list { margin-top: -10px; }
    .item {
      padding: 9px 0;
      font-size: 14px;
      line-height: 1.6;
    }
    .item-date { font-size: 11px; }
    .more { font-size: 14px; }
    .links {
      flex-direction: row;
      gap: 24px;
      font-size: 14px;
      line-height: 1.55;
    }
    .links a { padding: 10px 0; }
  }

  /* ── Phone top (p4): one column; categories scroll sideways ── */
  @media (max-width: 759px) {
    .index {
      gap: 20px;
      padding: 0 var(--inset-x);
    }
    .site { font-size: 26px; }
    .scroll-foot { margin-top: calc(48px - 20px); }
    .intro { padding-top: 20px; }
    .cats {
      flex-wrap: nowrap;
      gap: 0 18px;
      margin-top: 36px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .cats::-webkit-scrollbar { display: none; }
    .cat {
      flex: none;
      padding: 12px 0 8px;
    }
    .list { margin-top: -20px; }
    .links a { padding: 12px 0; }
  }
</style>

<script>
  // Category filter (dims non-matching posts, never hides them) and
  // "さらに読み込む" (20 more per press, after ~600ms of 「読み込み中…」).
  // State lives in sessionStorage so it survives moving between articles,
  // as it would in the single-page prototype.
  const KEY = 'fragments-index';
  type State = { cat?: string; limit?: number; scroll?: number };
  const load = (): State => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) || '{}');
    } catch {
      return {};
    }
  };
  const save = (patch: State) => {
    try {
      sessionStorage.setItem(KEY, JSON.stringify({ ...load(), ...patch }));
    } catch {}
  };

  const nav = document.querySelector<HTMLElement>('[data-index]');
  if (nav) {
    const cats = [...nav.querySelectorAll<HTMLButtonElement>('.cat')];
    const items = [...nav.querySelectorAll<HTMLAnchorElement>('.item')];
    const more = nav.querySelector<HTMLButtonElement>('.more');
    const step = Number(more?.dataset.step ?? 20);
    const state = load();

    const setCat = (cat: string) => {
      cats.forEach((b) => {
        const on = b.dataset.cat === cat;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      items.forEach((a) => a.classList.toggle('is-dim', cat !== 'all' && a.dataset.cat !== cat));
    };
    const setLimit = (limit: number) => {
      items.forEach((a, i) => a.toggleAttribute('data-more', i >= limit));
      if (more) more.hidden = limit >= items.length;
    };

    let cat = state.cat && cats.some((b) => b.dataset.cat === state.cat) ? state.cat : 'all';
    // Always list the article being read.
    const cur = items.findIndex((a) => a.classList.contains('is-current'));
    let limit = Math.max(state.limit ?? step, cur >= 0 ? Math.ceil((cur + 1) / step) * step : 0);
    setCat(cat);
    setLimit(limit);
    if (state.scroll) {
      // restoring the position is not the reader scrolling: no thumb flash
      nav.dataset.restoring = '';
      nav.scrollTop = state.scroll;
      requestAnimationFrame(() => requestAnimationFrame(() => delete nav.dataset.restoring));
    }

    cats.forEach((b) =>
      b.addEventListener('click', () => {
        cat = b.dataset.cat!;
        setCat(cat);
        save({ cat });
      }),
    );

    let loading = false;
    more?.addEventListener('click', () => {
      if (loading) return;
      loading = true;
      more.textContent = '読み込み中…';
      setTimeout(() => {
        loading = false;
        more.textContent = 'さらに読み込む';
        limit += step;
        setLimit(limit);
        save({ limit });
      }, 600);
    });

    addEventListener('pagehide', () => save({ scroll: nav.scrollTop }));
  }
</script>
