---
// Book card: 72×104 cover, title, author / publisher / year, store link.
// <BookCard title="…" author="…" publisher="…" year={2020} url="https://…" cover="/img/cover.jpg" />
interface Props {
  title: string;
  author: string;
  publisher?: string;
  year?: number | string;
  url: string;
  cover?: string;
  /** label of the link at the bottom right */
  store?: string;
}
const { title, author, publisher, year, url, cover, store = 'Amazon' } = Astro.props;
const meta = `${author}（著）` + (publisher ? `／${publisher}` : '') + (year ? `、${year}年` : '');
---

<a class="el-book" href={url} target="_blank" rel="noopener">
  {cover ? <img class="el-cover" src={cover} alt="" loading="lazy" decoding="async" /> : <div class="el-cover el-placeholder">cover</div>}
  <div class="el-info">
    <span class="el-title">{title}</span>
    <span class="el-meta">{meta}</span>
    <span class="el-store">{store} ↗</span>
  </div>
</a>

