---
// Text-only card for an external page: domain, title, description.
// <LinkCard url="https://example.com/…" title="…" description="…" />
interface Props {
  url: string;
  title: string;
  description?: string;
}
const { url, title, description } = Astro.props;
const domain = new URL(url).hostname.replace(/^www\./, '');
---

<a class="el-link" href={url} target="_blank" rel="noopener">
  <span class="el-domain">{domain}</span>
  <span class="el-title">{title}</span>
  {description && <span class="el-desc">{description}</span>}
</a>

