---
// Image at the body's full width, 3:2, with a caption.
// <Figure src="/img/x.jpg" alt="…" caption="図1　…" />
// Without `src` it draws the grey placeholder from the design.
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
}
const { src, alt = '', caption } = Astro.props;
---

<figure class="el-figure">
  {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <div class="el-placeholder">image（3:2）</div>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

