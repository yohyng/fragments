---
// Quotation with its source.
// <Quote source="— 著者名『書名』出版社、2020年、p.24">引用文…</Quote>
// (A plain Markdown `>` blockquote gets the same look, without the source line.)
interface Props {
  source?: string;
}
const { source } = Astro.props;
---

<blockquote>
  <div class="text"><slot /></div>
  {source && <cite>{source}</cite>}
</blockquote>

<style>
  .text {
    text-indent: 1em;
  }
</style>
