---
// Subscribe box: one 1px accent frame holding the email field and the button.
// After sending it is replaced by the 「✓ Subscribed」 band and a note.
// compact (the article's end): on phones only the button shows, beside the
// share buttons; pressing it stretches the bar out over them with the email
// field, and a press outside it (or Esc) folds it back.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['subscribe', { 'is-compact': compact }]} data-subscribe>
  <form class="field" novalidate>
    <input
      type="email"
      name="email"
      autocomplete="email"
      aria-label="メールアドレス"
      placeholder="email@example.com　新着記事をメールで受け取る"
    />
    <!-- left empty by people (it is off screen); bots fill it in -->
    <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="submit">Subscribe</button>
  </form>
  <p class="note" role="status" data-note hidden></p>
  <!-- the purpose of use, shown where the address is taken (as Japan's
       privacy law asks): only a link -->
  <p class="policy" data-policy><a href="/privacy/">Privacy Policy</a></p>
  <div class="done" hidden>
    <div class="band"><span class="check" aria-hidden="true">✓</span><span>Subscribed</span></div>
    <div class="msg" role="status"></div>
  </div>
</div>

<style>
  .field {
    display: flex;
    height: 34px;
    border: 1px solid var(--color-accent);
    border-radius: 0;
    margin: 0;
  }
  .field[hidden] {
    display: none;
  }
  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0 12px;
    font-family: var(--font-body), 'Zen Old Mincho', serif;
    font-size: 14px;
    color: var(--color-text);
    background: transparent;
    border: 0;
    border-radius: 0;
    outline: none;
  }
  input:focus,
  input:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 0.5px var(--color-accent);
  }
  input::placeholder {
    font-size: 12px;
    color: var(--color-neutral-500);
  }
  button {
    flex: none;
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-family: var(--font-body);
    font-size: 13px;
    color: #fff;
    background: var(--color-accent);
    text-decoration: none;
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }
  button:hover {
    background: var(--color-accent-600);
  }
  .done:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  /* the whole box in the accent, 「✓ Subscribed」 in white */
  .band {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 12px;
    box-sizing: border-box;
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    font-family: var(--font-body);
    font-size: 13px;
    color: #fff;
  }
  .check {
    font-size: 12px;
    line-height: 1;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .note {
    margin: 4px 0 0;
  }
  .policy {
    margin: 5px 0 0;
    font-family: var(--font-body);
    font-size: 9px;
    line-height: 1.6;
    color: var(--color-neutral-500);
  }
  .policy a {
    color: inherit;
    text-decoration-color: var(--color-divider);
  }
  .policy a:hover {
    color: var(--color-accent-700);
  }
  .note.is-error {
    color: var(--color-accent-700);
  }
  .msg,
  .note {
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--color-neutral-700);
  }
  /* Phone: 16px keeps iOS from zooming into the field */
  @media (max-width: 759px) {
    input {
      font-size: 16px;
    }
    input::placeholder {
      font-size: 10.5px;
    }
    /* compact: the box keeps the button's width in the row; the bar grows
       out of it to the row's width (--open-w, set by the script), over
       what is beside it */
    .subscribe.is-compact.is-compact {
      position: relative;
      z-index: 3;
      flex: none;
      width: var(--closed-w, 92px);
    }
    .is-compact .field {
      position: relative;
      box-sizing: border-box;
      width: var(--closed-w, 92px);
      background: var(--color-bg);
      overflow: hidden;
      transition: width 0.28s ease;
    }
    .is-compact.is-open .field {
      width: var(--open-w, 100%);
    }
    .is-compact input {
      transition: opacity 0.2s ease 0.08s;
    }
    .is-compact:not(.is-open) input {
      padding: 0;
      opacity: 0;
      transition: none;
    }
    .is-compact .policy,
    .is-compact .note {
      position: absolute;
      top: 100%;
      left: 0;
      width: var(--open-w, 100%);
    }
    .is-compact:not(.is-open) .policy,
    .is-compact:not(.is-open) .note {
      visibility: hidden;
    }
  }
</style>

<script>
  import { subscribe } from '../lib/subscribe';

  // after the links in the mails (api/confirm, api/unsubscribe): /subscribe/?status=…
  const RESULT: Record<string, { done?: string; note?: string; error?: boolean }> = {
    confirmed: { done: '登録が完了しました。新しい記事をメールでお届けします。' },
    unsubscribed: { note: '配信を停止しました。また読みたくなったら、いつでも登録し直せます。' },
    invalid: { note: 'このリンクは使えなくなっています。お手数ですが、もう一度登録してください。', error: true },
    error: { note: 'うまく処理できませんでした。時間をおいて、もう一度お試しください。', error: true },
  };
  const result = RESULT[new URLSearchParams(location.search).get('status') ?? ''];

  document.querySelectorAll<HTMLElement>('[data-subscribe]').forEach((box) => {
    const form = box.querySelector('form')!;
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const hp = form.querySelector<HTMLInputElement>('input[name="website"]')!;
    const button = form.querySelector('button')!;
    const done = box.querySelector<HTMLElement>('.done')!;
    const note = box.querySelector<HTMLElement>('[data-note]')!;
    let sending = false;

    // compact (phones): the button opens the bar first; outside or Esc closes it
    const compact = () => box.classList.contains('is-compact') && matchMedia('(max-width: 759px)').matches;
    const measure = () => {
      if (!box.classList.contains('is-compact')) return;
      box.style.setProperty('--closed-w', button.offsetWidth + 2 + 'px');
      box.style.setProperty('--open-w', (box.parentElement?.clientWidth ?? 0) + 'px');
    };
    const setOpen = (open: boolean) => {
      measure();
      box.classList.toggle('is-open', open);
      if (open) input.focus({ preventScroll: true });
    };
    measure();
    document.fonts?.ready.then(measure);
    addEventListener('resize', measure);
    button.addEventListener('click', (e) => {
      if (compact() && !box.classList.contains('is-open')) {
        e.preventDefault();
        setOpen(true);
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (box.classList.contains('is-open') && !box.contains(e.target as Node)) setOpen(false);
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && box.classList.contains('is-open')) {
        setOpen(false);
        button.focus();
      }
    });

    const showDone = (text: string) => {
      // the band and its note take the whole row
      box.classList.remove('is-compact', 'is-open');
      done.querySelector('.msg')!.textContent = text;
      form.hidden = true;
      note.hidden = true;
      box.querySelector<HTMLElement>('[data-policy]')!.hidden = true;
      done.hidden = false;
    };
    const showNote = (text: string, error = false) => {
      note.textContent = text;
      note.classList.toggle('is-error', error);
      note.hidden = !text;
    };
    if (result?.done) showDone(result.done);
    else if (result?.note) showNote(result.note, result.error);

    // Click or Enter. Input without "@" does nothing.
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (sending || !email.includes('@')) return;
      sending = true;
      button.textContent = 'Sending…';
      showNote('');
      try {
        const state = await subscribe(email, hp.value);
        showDone(
          state === 'active'
            ? email + ' を登録しました。新しい記事をメールでお届けします。'
            : email + ' に確認メールを送りました。メール内のリンクを押すと登録が完了します。',
        );
      } catch (err) {
        showNote(
          (err as Error).message === 'invalid'
            ? 'メールアドレスの形が正しくないようです。確かめてください。'
            : '送信できませんでした。時間をおいて、もう一度お試しください。',
          true,
        );
      } finally {
        sending = false;
        button.textContent = 'Subscribe';
      }
    });
  });
</script>
