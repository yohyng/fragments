---
// p3: catch and description where the body goes, contact where the notes go.
// The bottom rule is always shown.
import Page from '../layouts/Page.astro';
import { site } from '../lib/site';
---

<Page title="about — fragments" description={`${site.name}について。${site.catchJa} ${site.catchEn}`}>
  <main class="column" data-scroll data-noscrollbar>
    <div class="rule"><a class="site" href="/">fragments</a></div>
    <header class="head">
      <h1>about</h1>
    </header>
    <div class="grid">
      <div class="text">
        <p class="catch-ja">{site.catchJa}</p>
        <p class="catch-en">{site.catchEn}</p>
        <p class="desc">{site.about}</p>
      </div>
      <div class="side">
        <div class="contact">
          <span class="label">Contact</span>
          {site.contact.map((c) => <a href={c.href}>{c.label}</a>)}
        </div>
      </div>
    </div>
    <div class="end-space"></div>
    <div class="endrule" data-endrule></div>
  </main>
</Page>

<style>
  .column {
    height: 100%;
    overflow-y: auto;
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
  }
  .rule {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-bg);
    height: 36px;
    padding-bottom: 6px;
    box-sizing: content-box;
    border-bottom: 1px solid var(--color-neutral-700);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 56px;
    min-height: 220px;
    box-sizing: border-box;
  }
  h1 {
    font-family: var(--font-mincho-heading);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 34em) 300px;
    column-gap: 88px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: clamp(15px, 0.8rem + 0.2vw, 16px);
    line-height: 1.9;
  }
  .catch-ja {
    margin: 0;
    font-family: var(--font-mincho-heading);
    font-size: 18px;
    line-height: 1.7;
  }
  .catch-en {
    margin: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-neutral-800);
  }
  .desc {
    margin: 0;
    font-family: var(--font-mincho);
    text-align: justify;
    color: var(--color-neutral-800);
    padding-top: 20px;
    border-top: 1px solid var(--color-divider);
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: var(--font-mincho);
    font-size: 12px;
    line-height: 1.75;
    color: var(--color-neutral-800);
  }
  .contact {
    display: flex;
    flex-direction: column;
  }
  .label {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-neutral-700);
  }
  .end-space {
    min-height: 96px;
    flex: 1 0 96px;
  }
  .endrule {
    flex: none;
    position: sticky;
    bottom: 0;
    height: 0;
    border-top: 1px solid var(--color-neutral-700);
  }
  /* always shown on this page */
  .endrule[data-endrule] {
    opacity: 1;
  }
  .site {
    display: none;
  }

  /* Compact 3 columns, narrow end: contact in the 210px note position
     (from 1300px the PC grid fits; its text column gives way) */
  @media (min-width: 1160px) and (max-width: 1299px) {
    .grid {
      grid-template-columns: minmax(0, calc(30 * clamp(15px, 0.8rem + 0.2vw, 16px))) 210px;
      column-gap: 40px;
    }
  }

  /* Not in the design: follows the tablet / phone article (p6 / p5) —
     site name in the header, contact where the notes go (tablet) or
     after the text (phone). */
  @media (max-width: 1159px) {
    .rule {
      z-index: 2;
      height: auto;
      box-sizing: border-box;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .site {
      display: block;
      font-family: var(--font-heading);
      font-size: 28px;
      line-height: 1.2;
      text-decoration: none;
    }
    .site,
    .site:hover {
      color: var(--color-text);
    }
    .head {
      min-height: 0;
      padding: 56px 0 40px;
    }
    .grid {
      grid-template-columns: minmax(0, 465px) 210px;
      column-gap: 40px;
    }
    .text {
      font-size: 15.5px;
    }
    .end-space {
      min-height: 80px;
      flex-basis: 80px;
    }
  }
  @media (max-width: 759px) {
    .rule {
      z-index: 1;
      display: block;
    }
    .site {
      font-size: 22px;
    }
    .head {
      padding: 40px 0 36px;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
    }
    .end-space {
      min-height: 48px;
      flex-basis: 48px;
    }
  }
</style>
