---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteIndex from '../../components/SiteIndex.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getPosts, formatDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}
const { post, posts } = Astro.props;
const { Content } = await render(post.entry);

// posts are newest first: 「前の記事」 is the next older one, 「次の記事」 the next newer one
const i = posts.findIndex((p) => p.slug === post.slug);
const prev = posts[i + 1];
const next = posts[i - 1];
// 関連する記事: same category, newest first
const related = posts.filter((p) => p.category === post.category && p.slug !== post.slug).slice(0, 3);
---

<Base title={`${post.title} — fragments`}>
  <div class="page">
    <SiteIndex posts={posts} current={post.slug} />
    <main class="column" data-scroll data-noscrollbar>
      <div class="rule" aria-hidden="true"></div>
      <article>
        <header class="head">
          <h1>{post.title}</h1>
          {post.subtitle && <div class="subtitle">{post.subtitle}</div>}
          <time class="date" datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
        </header>
        <div class="body">
          <Content />
        </div>
      </article>
      <aside class="sub" aria-label="購読">
        <Subscribe />
      </aside>
      <nav class="pager" aria-label="前後の記事">
        {
          prev && (
            <a class="prev" href={`/posts/${prev.slug}/`} rel="prev">
              <span class="label">前の記事</span>
              <span>{prev.title}</span>
            </a>
          )
        }
        {
          next && (
            <a class="next" href={`/posts/${next.slug}/`} rel="next">
              <span class="label">次の記事</span>
              <span>{next.title}</span>
            </a>
          )
        }
      </nav>
      {
        related.length > 0 && (
          <nav class="related" aria-label="関連する記事">
            <div class="related-label">関連する記事</div>
            {related.map((r) => (
              <a href={`/posts/${r.slug}/`}>
                <span class="related-title">
                  {r.title}
                  {r.subtitle && <span class="related-sub">{r.subtitle}</span>}
                </span>
                <span class="related-date">{formatDate(r.date)}</span>
              </a>
            ))}
          </nav>
        )
      }
      <div class="end-space"></div>
      <div class="endrule" data-endrule></div>
    </main>
  </div>
</Base>

<style>
  .page {
    height: 100vh;
    overflow: hidden;
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    column-gap: 56px;
    padding: 48px 32px 32px;
  }
  .column {
    height: 100%;
    overflow-y: auto;
    padding-bottom: 0;
  }
  /* Article end: subscribe → prev / next → related (widths follow the body's 34em) */
  .sub,
  .pager,
  .related {
    max-width: calc(34 * clamp(15px, 0.8rem + 0.2vw, 16px));
  }
  .sub {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 96px;
    padding: 48px 0 12px;
    border-top: 1px solid var(--color-text);
    font-family: var(--font-mincho);
    font-size: 14px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    margin-top: 40px;
    font-family: var(--font-mincho);
    font-size: 13px;
    line-height: 1.75;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--color-accent-700);
  }
  .pager .next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }
  .pager .label {
    font-family: var(--font-body);
    font-size: 11.5px;
    color: var(--color-neutral-700);
  }
  .related {
    display: flex;
    flex-direction: column;
    margin-top: 48px;
  }
  .related-label {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-neutral-700);
    padding-bottom: 6px;
  }
  .related a {
    display: block;
    padding: 6px 0;
    font-family: var(--font-mincho);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text);
    text-decoration: none;
  }
  .related a:hover {
    color: var(--color-accent-700);
  }
  .related-title {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .related-sub {
    margin-left: 8px;
    color: var(--color-neutral-700);
  }
  .related-date {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-neutral-700);
    font-variant-numeric: tabular-nums;
  }
  .end-space {
    height: 96px;
  }
  .endrule {
    position: sticky;
    bottom: 0;
    height: 0;
    border-top: 1px solid var(--color-neutral-700);
  }
  .rule {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-bg);
    height: 36px;
    padding-bottom: 6px;
    box-sizing: content-box;
    border-bottom: 1px solid var(--color-neutral-700);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 56px;
    min-height: 220px;
    box-sizing: border-box;
  }
  h1 {
    font-family: var(--font-mincho-heading);
    font-weight: 500;
    font-size: clamp(26px, 1.4rem + 0.6vw, 32px);
    line-height: 1.4;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .subtitle {
    font-family: var(--font-mincho-heading);
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-neutral-800);
  }
  .date {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-neutral-700);
    font-variant-numeric: tabular-nums;
    margin-top: 10px;
  }
  .body {
    max-width: 34em;
    font-family: var(--font-mincho);
    font-size: clamp(15px, 0.8rem + 0.2vw, 16px);
    line-height: 1.9;
    text-align: justify;
    letter-spacing: 0.02em;
  }
  .body :global(p),
  .body :global(.p) {
    margin: 0;
    text-indent: 1em;
  }

  /* Note number square — in the text */
  .body :global(.note-ref) {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-indent: 0;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    box-sizing: border-box;
    font-size: 10px;
    line-height: 1;
    color: #fff;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    border-radius: 1px;
    margin: 0 2px;
    vertical-align: 4px;
    background: var(--color-accent);
  }
  .body :global(.note-ref a),
  .body :global(.note-num) {
    color: #fff;
    text-decoration: none;
  }

  /* Sidenote */
  .body :global(.sidenote) {
    display: inline;
    float: right;
    clear: right;
    width: 300px;
    margin-right: -388px;
    margin-bottom: 16px;
    text-indent: 0;
    text-align: left;
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-neutral-800);
    background: transparent;
  }
  .body :global(.sidenote-head) {
    display: block;
    color: var(--color-text);
  }
  .body :global(.note-num) {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-indent: 0;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    box-sizing: border-box;
    font-size: 10px;
    line-height: 1;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    border-radius: 1px;
    margin-right: 8px;
    vertical-align: 2px;
    background: var(--color-accent);
  }
  .body :global(.sidenote-cite) {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-neutral-700);
    margin: 2px 0 4px;
  }
  .body :global(.sidenote-body) {
    display: block;
    text-align: justify;
  }

  /* Hover / jump highlight */
  .body :global(.note-ref.is-hl),
  .body :global(.sidenote.is-hl .note-num) {
    background: var(--color-accent-900);
  }
  .body :global(.sidenote.is-hl) {
    background: var(--color-accent-100);
  }
</style>

<script>
  // Hover a number or note → highlight both. Click a number → smooth-scroll to
  // its counterpart inside the column, then keep it highlighted for 1.6s.
  // (The scroll moves the number out from under the cursor, which fires
  // mouseleave; that must not end the 1.6s highlight.)
  let timer: ReturnType<typeof setTimeout> | undefined;
  let jumping = false;
  const pair = (id: string) => document.querySelectorAll(`[data-note="${CSS.escape(id)}"]`);
  const setHl = (id: string | null) => {
    document.querySelectorAll('[data-note].is-hl').forEach((n) => n.classList.remove('is-hl'));
    if (id) pair(id).forEach((n) => n.classList.add('is-hl'));
  };
  const go = (targetId: string, id: string) => {
    const el = document.getElementById(targetId);
    if (el) {
      const r = el.getBoundingClientRect();
      const sc = el.closest<HTMLElement>('[data-scroll]');
      if (sc) {
        const sr = sc.getBoundingClientRect();
        sc.scrollTo({ top: sc.scrollTop + r.top - sr.top - sr.height / 3, behavior: 'smooth' });
      } else {
        window.scrollTo({ top: window.scrollY + r.top - window.innerHeight / 3, behavior: 'smooth' });
      }
    }
    setHl(id);
    jumping = true;
    clearTimeout(timer);
    timer = setTimeout(() => {
      jumping = false;
      setHl(null);
    }, 1600);
  };

  document.querySelectorAll<HTMLElement>('[data-note]').forEach((node) => {
    const id = node.dataset.note!;
    node.addEventListener('mouseenter', () => {
      clearTimeout(timer);
      jumping = false;
      setHl(id);
    });
    node.addEventListener('mouseleave', () => {
      if (!jumping) setHl(null);
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('.note-ref a, .note-num').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const target = a.getAttribute('href')!.slice(1);
      go(target, target.replace(/^(note|ref)-/, ''));
    });
  });
</script>
