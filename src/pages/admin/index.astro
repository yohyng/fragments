---
// /admin/: write, edit and publish articles (Supabase, shared with studieslog).
// Not part of the public design: a plain working screen in fragments' type.
import '../../styles/tokens.css';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>管理画面 — fragments</title>
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond&family=Lora:ital@0;1&family=Shippori+Mincho:wght@400;500&family=Zen+Old+Mincho&display=swap"
    />
  </head>
  <body>
    <header class="bar">
      <a class="site" href="/">fragments</a>
      <span class="where">管理画面</span>
      <span class="spacer"></span>
      <span class="who" data-who></span>
      <button type="button" class="link" data-signout hidden>ログアウト</button>
    </header>

    <!-- sign in -->
    <section class="view" data-view="login" hidden>
      <form class="login" data-login>
        <h1>ログイン</h1>
        <label>メールアドレス<input type="email" name="email" autocomplete="username" required /></label>
        <label>パスワード<input type="password" name="password" autocomplete="current-password" required /></label>
        <button type="submit" class="primary">ログイン</button>
        <p class="msg" data-login-msg></p>
      </form>
    </section>

    <!-- list -->
    <section class="view" data-view="list" hidden>
      <div class="list-head">
        <h1>記事</h1>
        <button type="button" class="primary" data-new>新しい記事</button>
      </div>
      <table class="list">
        <thead><tr><th>日付</th><th>タイトル</th><th>カテゴリ</th><th>状態</th></tr></thead>
        <tbody data-rows></tbody>
      </table>
    </section>

    <!-- edit -->
    <section class="view" data-view="edit" hidden>
      <div class="edit-head">
        <button type="button" class="link" data-back>← 記事の一覧</button>
        <span class="spacer"></span>
        <a class="link" data-view-on-site target="_blank" rel="noopener" hidden>サイトで見る ↗</a>
      </div>
      <div class="edit">
        <div class="main">
          <textarea class="title" data-f="title" placeholder="タイトル" rows="1"></textarea>
          <input class="subtitle" data-f="subtitle" placeholder="サブタイトル（なくても可）" />
          <div class="toolbar" data-toolbar>
            <button type="button" data-cmd="p" title="本文">本文</button>
            <button type="button" data-cmd="h2" title="見出し">見出し</button>
            <button type="button" data-cmd="h3" title="小見出し">小見出し</button>
            <button type="button" data-cmd="quote" title="引用">引用</button>
            <button type="button" data-cmd="ul" title="箇条書き">・</button>
            <button type="button" data-cmd="ol" title="番号付きリスト">1.</button>
            <span class="sep"></span>
            <button type="button" data-cmd="link" title="リンク">リンク</button>
            <button type="button" data-cmd="image" title="画像">画像</button>
            <button type="button" data-cmd="card" title="書籍・リンクカード">カード</button>
            <button type="button" data-cmd="note" title="注を入れる" class="accent">注</button>
            <span class="sep"></span>
            <button type="button" data-cmd="undo" title="元に戻す">↶</button>
            <button type="button" data-cmd="redo" title="やり直す">↷</button>
            <input type="file" accept="image/*" data-image-file hidden />
          </div>
          <div class="editor" data-editor></div>
        </div>
        <aside class="side">
          <div class="box">
            <label>日付<input type="date" data-f="date" /></label>
            <label>カテゴリ
              <select data-f="category">
                <option value="essay">essay</option>
                <option value="sketch">sketch</option>
                <option value="log">log</option>
              </select>
            </label>
            <label>状態
              <select data-f="status">
                <option value="draft">下書き</option>
                <option value="published">公開</option>
                <option value="scheduled">予約</option>
                <option value="private">非公開</option>
              </select>
            </label>
            <label data-scheduled-row hidden>公開する日時<input type="datetime-local" data-f="scheduled_at" /></label>
            <button type="button" class="primary" data-save>保存</button>
            <p class="msg" data-save-msg></p>
            <button type="button" class="link danger" data-delete hidden>この記事を削除</button>
          </div>
          <div class="box notes">
            <h2>注</h2>
            <p class="hint">本文で「注」を押すと、カーソルの位置に注が入ります。ここで中身を書きます。書誌を書くときは見出しも書いてください。</p>
            <ol data-notes></ol>
          </div>
        </aside>
      </div>
    </section>

    <script>
      import '../../admin/app';
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body), 'Zen Old Mincho', serif;
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  [hidden] { display: none !important; }
  button, input, select, textarea { font: inherit; color: inherit; }
  .bar {
    position: sticky; top: 0; z-index: 5;
    display: flex; align-items: baseline; gap: 16px;
    padding: 16px 32px 10px;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-neutral-700);
  }
  .site { font-family: var(--font-heading); font-size: 26px; line-height: 1.2; color: var(--color-text); text-decoration: none; }
  .where { color: var(--color-neutral-700); font-family: var(--font-mincho); font-size: 13px; }
  .spacer { flex: 1; }
  .who { color: var(--color-neutral-700); font-size: 12px; }
  .link { background: none; border: 0; padding: 0; color: var(--color-accent-700); cursor: pointer; text-decoration: none; font-family: var(--font-mincho); font-size: 13px; }
  .link.danger { color: #b3261e; }
  .primary {
    padding: 8px 18px; border: 0; border-radius: 0;
    background: var(--color-accent); color: #fff; cursor: pointer;
    font-family: var(--font-body); font-size: 13px;
  }
  .primary:hover { background: var(--color-accent-600); }
  .primary:disabled { opacity: 0.5; cursor: default; }
  .view { padding: 32px; }
  h1 { font-family: var(--font-mincho-heading); font-weight: 500; font-size: 24px; margin: 0; letter-spacing: 0.02em; }
  h2 { font-family: var(--font-mincho-heading); font-weight: 500; font-size: 15px; margin: 0 0 6px; }
  label { display: flex; flex-direction: column; gap: 4px; font-family: var(--font-mincho); font-size: 12px; color: var(--color-neutral-700); }
  input, select, textarea {
    padding: 7px 9px; border: 1px solid var(--color-divider); border-radius: 0;
    background: #fff8; color: var(--color-text); font-size: 14px;
  }
  input:focus, select:focus, textarea:focus { outline: none; box-shadow: inset 0 0 0 1px var(--color-accent); }
  .msg { min-height: 1.6em; margin: 0; font-family: var(--font-mincho); font-size: 12px; color: var(--color-neutral-700); }
  .msg.error { color: #b3261e; }

  .login { max-width: 360px; margin: 48px auto; display: flex; flex-direction: column; gap: 16px; }

  .list-head { display: flex; align-items: baseline; justify-content: space-between; max-width: 960px; margin-bottom: 18px; }
  table.list { width: 100%; max-width: 960px; border-collapse: collapse; font-family: var(--font-mincho); }
  .list th { text-align: left; font-family: var(--font-body); font-weight: 400; font-size: 11px; color: var(--color-neutral-700); padding: 6px 8px; border-bottom: 1px solid var(--color-divider); }
  .list td { padding: 9px 8px; border-bottom: 1px solid var(--color-divider); vertical-align: top; }
  .list tr[data-id] { cursor: pointer; }
  .list tr[data-id]:hover td { background: var(--color-accent-100); }
  .list .date, .list .cat { font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-700); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .badge { font-family: var(--font-mincho); font-size: 12px; white-space: nowrap; }
  .badge.published { color: var(--color-accent-700); }
  .badge.scheduled { color: var(--color-text); }
  .badge.draft, .badge.private { color: var(--color-neutral-500); }

  .edit-head { display: flex; align-items: baseline; margin-bottom: 18px; }
  .edit { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 40px; align-items: start; }
  /* The article as it is set on the site (Article.astro): body 34em of
     clamp(15px…16px), line-height 1.9, 0.02em tracking, justified, first-line
     indent, no gap between paragraphs; the title wraps at the body's width. */
  .main {
    --body-size: clamp(15px, 0.8rem + 0.2vw, 16px);
    min-width: 0;
    max-width: calc(34 * var(--body-size));
  }
  .title, .subtitle { width: 100%; border: 0; border-bottom: 1px solid var(--color-divider); background: transparent; padding: 6px 0; font-family: var(--font-mincho-heading); }
  .title { display: block; resize: none; overflow: hidden; font-size: clamp(26px, 1.4rem + 0.6vw, 32px); font-weight: 500; line-height: 1.4; letter-spacing: 0.02em; }
  .subtitle { font-size: 17px; line-height: 1.6; margin-top: 4px; color: var(--color-neutral-800); }
  .title:focus, .subtitle:focus { box-shadow: none; border-bottom-color: var(--color-accent); }
  .toolbar {
    position: sticky; top: 56px; z-index: 4;
    display: flex; flex-wrap: wrap; gap: 4px; align-items: center;
    margin: 18px 0 0; padding: 8px 0; background: var(--color-bg);
    border-bottom: 1px solid var(--color-divider);
  }
  .toolbar button { padding: 4px 9px; border: 1px solid var(--color-divider); background: transparent; cursor: pointer; font-family: var(--font-mincho); font-size: 12px; }
  .toolbar button:hover { border-color: var(--color-accent); color: var(--color-accent-700); }
  .toolbar button.accent { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .toolbar .sep { width: 10px; }

  .editor .ProseMirror {
    min-height: 60vh; padding: 24px 0 80px; outline: none;
    font-family: var(--font-mincho); font-size: var(--body-size); line-height: 1.9;
    letter-spacing: 0.02em; text-align: justify;
  }
  .editor .ProseMirror p { margin: 0; text-indent: 1em; }
  /* blank lines from the old editor: the site drops them, so they show here
     only as a thin dotted line */
  .editor .ProseMirror p.is-blank {
    height: 0.9em; line-height: 0.9em; overflow: hidden;
    background: linear-gradient(var(--color-divider), var(--color-divider)) center / 100% 1px no-repeat;
    background-image: repeating-linear-gradient(90deg, var(--color-neutral-300) 0 3px, transparent 3px 7px);
    background-size: 100% 1px;
  }
  .editor .ProseMirror h2 { font-family: var(--font-mincho-heading); font-weight: 500; font-size: 22px; line-height: 1.5; letter-spacing: 0.02em; margin: 2.2em 0 0.8em; text-indent: 0; }
  .editor .ProseMirror h3 { font-family: var(--font-mincho-heading); font-weight: 500; font-size: 17px; line-height: 1.6; letter-spacing: -0.015em; margin: 1.8em 0 0.4em; text-indent: 0; }
  .editor .ProseMirror blockquote { margin: 2em 0; padding: 2px 0 2px 1.5em; border-left: 1px solid var(--color-accent); color: var(--color-neutral-800); }
  .editor .ProseMirror ul, .editor .ProseMirror ol { margin: 1.6em 0; padding-left: 1.4em; }
  .editor .ProseMirror li p { text-indent: 0; }
  .editor .ProseMirror img { max-width: 100%; height: auto; border: 6px solid var(--color-surface); outline: 1px solid var(--color-divider); vertical-align: top; }
  .editor .ProseMirror img.ProseMirror-selectednode { outline: 2px solid var(--color-accent); }
  .editor .ProseMirror sup.footnote-ref {
    display: inline-flex; align-items: center; justify-content: center; text-indent: 0;
    min-width: 15px; height: 15px; padding: 0 3px; margin: 0 2px; vertical-align: 4px;
    background: var(--color-accent); color: #fff; font-family: var(--font-body); font-size: 10px; line-height: 1; letter-spacing: 0; cursor: pointer;
  }
  .editor .ProseMirror a { color: var(--color-accent-700); }
  .editor .ProseMirror a.book-link-card { text-indent: 0; }

  .side { position: sticky; top: 72px; display: flex; flex-direction: column; gap: 20px; max-height: calc(100vh - 90px); overflow: auto; }
  .box { display: flex; flex-direction: column; gap: 12px; padding: 16px; border: 1px solid var(--color-divider); }
  .hint { margin: 0; font-family: var(--font-mincho); font-size: 11.5px; line-height: 1.7; color: var(--color-neutral-700); }
  .notes ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .notes li { display: flex; flex-direction: column; gap: 6px; }
  .notes .num {
    align-self: flex-start; min-width: 15px; height: 15px; padding: 0 3px;
    background: var(--color-accent); color: #fff; font-size: 10px; line-height: 15px; text-align: center; font-variant-numeric: tabular-nums;
  }
  .notes textarea { min-height: 70px; resize: vertical; font-family: var(--font-mincho); font-size: 13px; line-height: 1.7; }
  .notes input { font-size: 13px; }

  @media (max-width: 900px) {
    .view { padding: 20px; }
    .bar { padding: 12px 20px 8px; }
    .edit { grid-template-columns: 1fr; }
    .side { position: static; max-height: none; }
  }
</style>
