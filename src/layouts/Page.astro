---
// PC page: index column (360px) | 56px | right column. 100vh, no page scroll;
// each column scrolls on its own.
import Base from './Base.astro';
import SiteIndex from '../components/SiteIndex.astro';
import { getPosts } from '../lib/posts';
import type { Props as SeoProps } from '../components/Seo.astro';

interface Props extends SeoProps {
  /** 'top': below 1200px only the index is shown; 'article': only the right column */
  mode?: 'top' | 'article';
  /** slug of the article being read */
  current?: string;
}
const { current, mode = 'article', ...seo } = Astro.props;
const posts = await getPosts();
---

<Base {...seo}>
  <div class:list={['page', `page--${mode}`]}>
    <SiteIndex posts={posts} current={current} />
    <slot />
  </div>
</Base>

<style>
  .page {
    /* html and body are 100% of the window's displayed area; vh/dvh can be
       taller than that (browser bars), which hid the bottom of the columns */
    height: 100%;
    overflow: hidden;
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    column-gap: 56px;
    padding: 48px 32px 32px;
  }
  /* Compact 3 columns (not in the design): the PC grid with the tablet's
     340px index and 40px gap, so that index + body + notes fit from 1160px */
  @media (min-width: 1160px) and (max-width: 1399px) {
    .page {
      grid-template-columns: 340px minmax(0, 1fr);
      column-gap: 40px;
    }
  }
  /* Tablet (p6/p7) */
  @media (max-width: 1159px) {
    .page {
      display: block;
      padding: 0; /* moved inside the column: see --inset-* in base.css */
    }
    .page--article > :global([data-index]) {
      display: none;
    }
  }
</style>
