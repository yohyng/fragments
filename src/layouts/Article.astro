---
// Right column of an article page: header rule, title block, body (with
// sidenotes), then the `end` slot, a 96px space and the bottom rule.
import { formatDate, isoDate } from '../lib/posts';
import '../styles/elements.css';

interface Props {
  title: string;
  subtitle?: string;
  date: Date;
}
const { title, subtitle, date } = Astro.props;
---

<main class="column" data-scroll data-noscrollbar>
  <div class="rule"><a class="site" href="/">fragments</a></div>
  <article>
    <header class="head">
      <h1>{title}</h1>
      {subtitle && <div class="subtitle">{subtitle}</div>}
      <time class="date" datetime={isoDate(date)}>{formatDate(date)}</time>
    </header>
    <!-- over the notes column: a light rule level with the date's, and 註
         above its left end level with the date (placed by the script) -->
    <div class="notes-head" aria-hidden="true" hidden><span class="notes-mark"><span class="notes-mark-ja">註</span> / <span class="notes-mark-en">annotation</span></span></div>
    <div class="body" data-fade-imgs>
      <slot />
    </div>
    <script is:inline>
      // Images arrive a moment after the text: each fades in once it has
      // loaded instead of popping in (see elements.css).
      document.currentScript.previousElementSibling.querySelectorAll('img').forEach((img) => {
        const show = () => img.classList.add('is-loaded');
        if (img.complete) return show();
        img.addEventListener('load', show);
        img.addEventListener('error', show);
      });
    </script>
  </article>
  <slot name="end" />
  <!-- the notes column's closing rule, level with the rule above the
       subscribe box (placed by the script) -->
  <div class="notes-foot" aria-hidden="true" hidden></div>
  <div class="end-space"></div>
  <div class="endrule" data-endrule></div>
  <div class="scroll-foot" aria-hidden="true"></div>
</main>

<style>
  /* ≥1400px: PC (p2/p8). 1160–1399px: compact 3 columns (see below).
     ≤1159px: tablet (p6). ≤759px: phone (p5); 656–759px: phone with sidenotes. */

  .column {
    /* body text size; larger on PC (see the ≥1400px block) */
    --body-size: clamp(15px, 0.8rem + 0.2vw, 16px);
    height: 100%;
    overflow-y: auto;
    padding-bottom: 0;
  }
  .end-space {
    height: 96px;
  }
  .endrule {
    position: sticky;
    bottom: 0;
    height: 0;
    border-top: 1px solid var(--color-neutral-700);
  }
  .rule {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-bg);
    height: calc(var(--s-site-name, 30) * 1.2px); /* the index site name's line (36px by default) */
    padding-bottom: 6px;
    box-sizing: content-box;
    border-bottom: 1px solid var(--color-neutral-700);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 56px;
    min-height: 220px;
    box-sizing: border-box;
    /* the title wraps at the body's width (34em of the body text) */
    max-width: calc(34 * var(--body-size));
  }
  h1 {
    font-family: var(--font-mincho-heading);
    font-weight: 500;
    font-size: clamp(26px, 1.4rem + 0.6vw, 32px);
    line-height: 1.4;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .subtitle {
    font-family: var(--font-mincho-heading);
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-neutral-800);
  }
  .date {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-neutral-700);
    font-variant-numeric: tabular-nums;
    margin-top: 10px;
    position: relative;
  }
  /* a thin, light rule under the date, flush left, drawn in the space above
     the body so nothing moves (表示設定 → 記事本文: length, 0 = none, and
     distance) */
  article {
    position: relative;
  }
  .column {
    position: relative; /* for .notes-foot */
  }
  .notes-head,
  .notes-foot {
    position: absolute;
    height: 1px;
    background: var(--color-divider);
    pointer-events: none;
  }
  .notes-mark {
    position: absolute;
    left: 0;
    font-family: var(--font-mincho);
    font-size: 13px;
    line-height: 1;
    color: var(--color-neutral-700);
    white-space: nowrap;
  }
  .notes-mark-en {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 12px;
  }
  .date::after {
    content: '';
    position: absolute;
    left: 0;
    /* beside the index set by the script (level with the index's rule);
       elsewhere --rule-gap below the date, per layout */
    top: var(--date-rule-top, calc(100% + var(--rule-gap, 16) * 1px));
    width: min(100%, calc(var(--s-date-rule, 900) * 1px));
    height: 1px;
    background: var(--color-divider);
  }
  .body {
    max-width: 34em;
    font-family: var(--font-mincho);
    font-size: var(--body-size);
    line-height: var(--s-lh, 1.9);
    text-align: var(--s-align, justify);
    letter-spacing: calc(var(--s-ls, 0.02) * 1em);
  }
  .body :global(p),
  .body :global(.p) {
    margin: 0;
    text-indent: var(--s-indent, 1em);
  }
  /* space between paragraphs: one line by default (表示設定 → 段落の間),
     plus any blank lines left between them (→ 空行の高さ; none by default) */
  .body :global(:is(p, .p, .blank) + :is(p, .p)) {
    margin-top: calc(var(--s-para, 1) * var(--s-lh, 1.9) * 1em);
  }
  /* a blank line adds its height; a negative one takes it from the space
     after it (its margin collapses with the next paragraph's), down to none */
  .body :global(.blank) {
    --blank-h: calc(var(--s-blank, 0) * var(--s-lh, 1.9) * 1em);
    height: max(0px, var(--blank-h));
    margin-bottom: max(min(0px, var(--blank-h)), -1 * var(--s-para, 1) * var(--s-lh, 1.9) * 1em);
  }

  /* Note number square — in the text */
  .body :global(.note-ref) {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-indent: 0;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    box-sizing: border-box;
    font-size: 10px;
    line-height: 1;
    color: #fff;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    border-radius: 1px;
    margin: 0 2px;
    vertical-align: 4px;
    background: var(--color-accent);
  }
  .body :global(.note-ref a),
  .body :global(.note-num) {
    color: #fff;
    text-decoration: none;
  }

  /* Sidenote */
  .body :global(.sidenote) {
    display: inline;
    float: right;
    clear: right;
    width: 300px;
    margin-right: -388px;
    margin-bottom: 16px;
    text-indent: 0;
    text-align: left;
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-neutral-800);
    background: transparent;
  }
  .body :global(.sidenote-head) {
    display: block;
    color: var(--color-text);
  }
  .body :global(.note-num) {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-indent: 0;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    box-sizing: border-box;
    font-size: 10px;
    line-height: 1;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    border-radius: 1px;
    margin-right: 8px;
    vertical-align: 2px;
    background: var(--color-accent);
  }
  .body :global(.sidenote-cite) {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-neutral-700);
    margin: 2px 0 4px;
  }
  .body :global(.sidenote-body) {
    display: block;
    text-align: justify;
  }
  /* long URLs (and other unbroken runs) break anywhere instead of pushing
     the note wide or stretching the justified line before them */
  .body :global(.sidenote),
  .body :global(.notes-item) {
    overflow-wrap: anywhere;
  }
  .body :global(.sidenote-body a) {
    /* a URL continues the line it starts on, so the line before it is not
       stretched by justification */
    word-break: break-all;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-divider);
  }
  .body :global(.sidenote-body a:hover) {
    color: var(--color-accent-700);
  }
  /* a link out of the article (in the text or a note) ends in ↗; not the
     note numbers, the cards or a linked image */
  .body :global(a[href]:not([href^="#"]):not([class*="el-"]):not(:has(img))::after) {
    content: '↗';
    display: inline-block;
    margin-left: 0.15em;
    font-family: var(--font-body);
    font-size: 0.85em;
    font-style: normal;
    line-height: 1;
    text-decoration: none;
    text-indent: 0;
  }

  /* Hover / jump highlight */
  .body :global(.note-ref.is-hl),
  .body :global(.sidenote.is-hl .note-num) {
    background: var(--color-accent-900);
  }
  .body :global(.sidenote.is-hl) {
    background: var(--color-accent-100);
  }

  .site {
    display: none;
  }
  .body :global(.notes-list) {
    display: none;
  }

  /* Elements inside the body (p8) */
  .body :global(h2) {
    font-family: var(--font-mincho-heading);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    margin: 2.2em 0 0.8em;
  }
  .body :global(h3) {
    font-family: var(--font-mincho-heading);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.6;
    margin: 1.8em 0 0.4em;
  }
  .body :global(blockquote) {
    margin: 2em 0;
    padding: 2px 0 2px 1.5em;
    border-left: 1px solid var(--color-accent);
    color: var(--color-neutral-800);
    font-style: italic;
  }
  .body :global(blockquote cite) {
    display: block;
    margin-top: 8px;
    font-style: normal;
    font-size: 12px;
    color: var(--color-neutral-700);
  }
  .body :global(ul),
  .body :global(ol) {
    margin: 1.6em 0;
    padding-left: 1.4em;
    text-indent: 0;
  }
  .body :global(li) {
    margin: 0;
  }

  /* ── PC (≥1400px): a size up from the design (body 16.5–18px), with the
     notes, title and headings scaled to match. The body gives way to the
     notes if the column is short. The --s-* values come from the display
     settings (src/lib/settings-shared.ts); the fallbacks are the defaults. ── */
  @media (min-width: 1400px) {
    .column {
      --body-size: clamp(
        calc((var(--s-body-pc, 18) - 1.5) * 1px),
        calc((var(--s-body-pc, 18) - 11.6) * 1px + 0.75vw),
        calc(var(--s-body-pc, 18) * 1px)
      );
    }
    h1 {
      font-size: clamp(
        calc((var(--s-title-pc, 36) - 6) * 1px),
        calc((var(--s-title-pc, 36) - 20) * 1px + 1.2vw),
        calc(var(--s-title-pc, 36) * 1px)
      );
    }
    .subtitle {
      font-size: calc(var(--s-sub-pc, 19) * 1px);
    }
    .date {
      font-size: calc(var(--s-date-pc, 13) * 1px);
    }
    .body :global(.sidenote) {
      font-size: calc(var(--s-note, 14) * 1px);
    }
    .body :global(.sidenote-cite),
    .body :global(blockquote cite) {
      font-size: 13px;
    }
    .body :global(h2) {
      font-size: 24px;
    }
    .body :global(h3) {
      font-size: 19px;
    }
  }

  /* ── Beside the index (≥1160px): the body is --s-measure characters wide
     (34 by default), the notes 300px (210px below 1300px) beside it, the
     gap between them the same as between the index and the body
     (表示設定 → 段のあいだの余白, 70px by default; Page.astro). The body
     gives way if the column is short; characters asked for beyond 34 are
     made room for by narrowing the notes (by up to 80px). 100cqi = the
     column. ── */
  @media (min-width: 1160px) {
    .column {
      container-type: inline-size;
      --note-max: 300px;
      --pc-gap: calc(var(--s-col-gap, 70) * 1px);
      --pc-body: min(
        calc(var(--s-measure, 34) * var(--body-size)),
        calc(100cqi - var(--note-max) - var(--pc-gap) + clamp(0px, (var(--s-measure, 34) - 34) * var(--body-size), 80px))
      );
      --pc-note: min(var(--note-max), 100cqi - var(--pc-body) - var(--pc-gap));
    }
    .head,
    .body {
      max-width: var(--pc-body);
    }
    .body :global(.sidenote) {
      width: var(--pc-note);
      margin-right: calc(-1 * (var(--pc-note) + var(--pc-gap)));
    }
  }
  @media (min-width: 1160px) and (max-width: 1299px) {
    .column {
      --note-max: 210px;
    }
  }

  /* ── Tablet (p6): no index; notes at 40px beside the body. At the
     narrowest (760px) as designed: body 15.5px, notes 210px. Wider, the
     text, the line length (up to 34 characters) and the notes grow with the
     screen, to 18px and 300px at 1159px, so wide tablets are not left with
     an empty margin. ── */
  @media (max-width: 1159px) {
    .column {
      padding: 0 var(--inset-x);
      --tab-size: clamp(
        calc(var(--s-body-tab, 15.5) * 1px),
        calc((var(--s-body-tab, 15.5) - 4.77) * 1px + 0.627vw),
        calc((var(--s-body-tab, 15.5) + 2.5) * 1px)
      );
      --tab-note: clamp(210px, 38.6px + 22.56vw, 300px);
    }
    .endrule {
      bottom: var(--inset-bottom);
    }
    .rule {
      padding-top: var(--inset-top);
      z-index: 2;
      /* the header covers the side margins too (see .scroll-foot) */
      box-shadow: calc(-1 * var(--inset-x)) 0 var(--color-bg), var(--inset-x) 0 var(--color-bg);
      height: auto;
      box-sizing: border-box;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .site {
      display: block;
      font-family: var(--font-heading);
      font-size: calc(var(--s-site-name, 30) * 28px / 30); /* 28px by default */
      line-height: 1.2;
      text-decoration: none;
    }
    .site,
    .site:hover {
      color: var(--color-text);
    }
    /* the head's sizes and gaps: 表示設定 → 記事本文 → 記事の見出し（タブレット）
       (the body follows the date's rule at a set distance: the script) */
    .head {
      min-height: 0;
      gap: 0;
      padding: calc(var(--s-title-top-tab, 56) * 1px) 0 0;
      max-width: min(calc(34 * var(--tab-size)), 100% - var(--tab-note) - 40px); /* = the body */
    }
    h1 {
      font-size: calc(var(--s-title-tab, 28) * 1px);
      line-height: 1.45;
      letter-spacing: -0.015em;
    }
    .subtitle {
      font-size: calc(var(--s-sub-tab, 15) * 1px);
      margin-top: calc(var(--s-sub-gap-tab, 4) * 1px);
    }
    .date {
      font-size: calc(var(--s-date-tab, 12) * 1px);
      margin-top: calc(var(--s-date-gap-tab, 12) * 1px);
      --rule-gap: var(--s-date-rule-gap-tab, 16);
    }
    .body {
      /* up to 34em, giving way so the notes still fit */
      max-width: min(34em, 100% - var(--tab-note) - 40px);
      font-size: var(--tab-size);
    }
    .body :global(.sidenote) {
      width: var(--tab-note);
      margin-right: calc(-1 * var(--tab-note) - 40px);
    }
    .end-space {
      height: 80px;
    }
  }

  /* ── Phone (p5): one column; notes gathered after the body ── */
  @media (max-width: 759px) {
    .rule {
      z-index: 1;
      display: block;
    }
    .site {
      font-size: calc(var(--s-site-name-sp, var(--s-site-name, 30) * 26 / 30) * 1px); /* as on the top page (26px by default) */
    }
    /* 表示設定 → 記事本文 → 記事の見出し（スマホ） */
    .head {
      padding-top: calc(var(--s-title-top-sp, 40) * 1px);
      max-width: none;
    }
    h1 {
      font-size: calc(var(--s-title-sp, 24) * 1px);
    }
    .subtitle {
      font-size: calc(var(--s-sub-sp, 15) * 1px);
      margin-top: calc(var(--s-sub-gap-sp, 4) * 1px);
    }
    .date {
      font-size: calc(var(--s-date-sp, 12) * 1px);
      margin-top: calc(var(--s-date-gap-sp, 12) * 1px);
      --rule-gap: var(--s-date-rule-gap-sp, 16);
    }
    .body {
      max-width: none;
    }
    .body :global(.sidenote) {
      display: none;
    }
    .body :global(.note-ref) {
      min-width: 13px;
      height: 13px;
      padding: 0 2px;
      font-size: 9px;
      vertical-align: 4px;
    }
    .body :global(.notes-list) {
      display: flex;
      flex-direction: column;
      margin-top: 56px;
      border-top: 1px solid var(--color-divider);
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.55;
      letter-spacing: normal;
      text-align: start;
    }
    .body :global(.notes-item) {
      padding: 10px 0;
      font-size: 13px;
      line-height: 1.8;
      color: var(--color-neutral-800);
      text-align: left;
    }
    .body :global(.notes-item.is-hl) {
      background: var(--color-accent-100);
    }
    .body :global(.notes-item.is-hl .note-num) {
      background: var(--color-accent-900);
    }
    .end-space {
      height: 48px;
    }
  }

  /* ── Wide phone, e.g. an unfolded foldable (not in the design): phone
     layout, but the notes go beside the body again (180px at 32px) ── */
  @media (min-width: 656px) and (max-width: 759px) {
    .body {
      max-width: min(30em, 100% - 212px);
    }
    .head {
      max-width: min(calc(30 * var(--s-body-tab, 15.5) * 1px), 100% - 212px);
    }
    .body :global(.sidenote) {
      display: inline;
      width: 180px;
      margin-right: -212px;
    }
    .body :global(.notes-list) {
      display: none;
    }
  }

  /* ── The header and footer rules stop where the text does: at the notes'
     right edge, or, in an article without notes, at the body's. --text-w is
     the body's width and --notes-w the body with the notes beside it, in
     each layout. The header keeps its full width as a background and draws
     its rule as a line of that width. ── */
  .column {
    --text-w: 100%;
    --notes-w: 100%;
    --line-w: var(--notes-w);
  }
  .column:not(:has(:global(.sidenote))) {
    --line-w: var(--text-w);
  }
  @media (min-width: 1160px) {
    .column {
      --text-w: var(--pc-body);
      --notes-w: calc(var(--pc-body) + var(--pc-gap) + var(--pc-note));
    }
  }
  @media (min-width: 760px) and (max-width: 1159px) {
    .column {
      --text-w: min(calc(34 * var(--tab-size)), 100% - var(--tab-note) - 40px);
      --notes-w: calc(var(--text-w) + 40px + var(--tab-note));
    }
  }
  @media (min-width: 656px) and (max-width: 759px) {
    .column {
      --text-w: min(calc(30 * var(--s-body-tab, 15.5) * 1px), 100% - 212px);
      --notes-w: calc(var(--text-w) + 212px);
    }
  }
  .rule {
    border-bottom-color: transparent;
  }
  .rule::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: var(--line-w);
    height: 1px;
    background: var(--color-neutral-700);
  }
  .endrule {
    max-width: var(--line-w);
  }

  /* ── Beside the index (≥1160px): the title's first line starts level with
     the catch copy's. The index puts that --s-ix-a below its header rule
     (56px by default), in lines 1.75 high; the title's lines are 1.4 high,
     so its half-leading is taken off and the catch copy's added. ── */
  @media (min-width: 1160px) {
    .head {
      /* (表示設定 → 記事の見出し（PC）: ヘッダーの線からタイトルまで, from this) */
      padding-top: calc(var(--s-ix-a, 56) * 1px + var(--s-catch-ja, 13) * (var(--s-catch-ja-lh, 1.75) - 1) / 2 * 1px + var(--s-title-top, 0) * 1px);
      /* the gaps below are each set; the date's rule is fixed level with the
         index's, the date set above it, and the body follows the rule at a
         set distance (the script) */
      gap: 0;
      min-height: 0;
    }
    h1 {
      margin-top: -0.2em;
    }
    .subtitle {
      margin-top: calc(var(--s-sub-gap, 4) * 1px);
    }
    .date {
      margin-top: 8px; /* at least; the script moves it down to the rule */
    }
  }
  /* the subtitle 2px and the date 1px smaller than set on narrower PCs
     (as before: 17 / 19, 12 / 13) */
  @media (min-width: 1160px) and (max-width: 1399px) {
    .subtitle {
      font-size: calc(var(--s-sub-pc, 19) * 1px - 2px);
    }
    .date {
      font-size: calc(var(--s-date-pc, 13) * 1px - 1px);
    }
  }
</style>

<script>
  // Beside the index (≥1160px): the rule under the date is fixed level with
  // the rule under the index's catch copy, and the date stands above it, its
  // bottom 表示設定 → 日付の下端から線まで above. Positions are taken from
  // each column's header rule, scroll left out. A long title that brings the
  // date lower keeps it there (at least 8px below), and the rule goes down
  // with it.
  function alignHead() {
    const col = document.querySelector<HTMLElement>('main.column');
    const head = col?.querySelector<HTMLElement>('.head');
    const date = head?.querySelector<HTMLElement>('.date');
    const rule = col?.querySelector<HTMLElement>('.rule');
    const index = document.querySelector<HTMLElement>('[data-index]');
    const en = index?.querySelector<HTMLElement>('.intro-en');
    const site = index?.querySelector<HTMLElement>('.site');
    if (!col || !head || !date || !rule || !index || !en || !site) return;
    date.style.marginTop = '';
    date.style.removeProperty('--date-rule-top');
    if (!matchMedia('(min-width: 1160px)').matches || !en.offsetParent) return;
    // y in the index, from the bottom of its header rule
    const ixTop = index.getBoundingClientRect().top - index.scrollTop;
    const ixRule = site.getBoundingClientRect().bottom - index.getBoundingClientRect().top;
    const inIndex = (y: number) => y - ixTop - ixRule;
    // y in the article column, from the bottom of its header rule
    const colTop = col.getBoundingClientRect().top - col.scrollTop;
    const colRule = rule.getBoundingClientRect().bottom - col.getBoundingClientRect().top;
    const inCol = (y: number) => y - colTop - colRule;

    const v = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--s-date-rule-gap-pc'));
    const gap = Number.isFinite(v) ? v : 14;
    // the index's rule: the catch copy's ::after, `top` below the copy's box
    const ixRuleY = inIndex(en.getBoundingClientRect().top + parseFloat(getComputedStyle(en, '::after').top));
    const margin = parseFloat(getComputedStyle(date).marginTop);
    const shift = ixRuleY - gap - inCol(date.getBoundingClientRect().bottom);
    if (shift > 0) date.style.marginTop = margin + shift + 'px';
    const ruleY = Math.max(ixRuleY, inCol(date.getBoundingClientRect().bottom) + gap);
    date.style.setProperty('--date-rule-top', ruleY - inCol(date.getBoundingClientRect().top) + 'px');
  }

  // Over the notes column (where the notes are beside the body): a light
  // rule level with the one under the date, as wide as the notes, and 註
  // above its left end with its text bottom level with the date's.
  function placeNotesHead() {
    const article = document.querySelector<HTMLElement>('main.column article');
    const nh = article?.querySelector<HTMLElement>('.notes-head');
    const mark = nh?.querySelector<HTMLElement>('.notes-mark');
    const date = article?.querySelector<HTMLElement>('.date');
    if (!article || !nh || !mark || !date) return;
    const note = [...article.querySelectorAll<HTMLElement>('.sidenote')].find((n) => getComputedStyle(n).display !== 'none');
    const dateRule = getComputedStyle(date, '::after');
    if (!note || !(parseFloat(dateRule.width) > 0)) {
      nh.hidden = true;
      const foot = article.closest('main')?.querySelector<HTMLElement>('.notes-foot');
      if (foot) foot.hidden = true;
      return;
    }
    nh.hidden = false;
    const a = article.getBoundingClientRect();
    const n = note.getBoundingClientRect();
    nh.style.left = n.left - a.left + 'px';
    nh.style.width = n.width + 'px';
    nh.style.top = date.getBoundingClientRect().top + parseFloat(dateRule.top) - a.top + 'px';
    // 註: its text bottom level with the date's
    mark.style.top = '0px';
    const bottom = (el: HTMLElement) => {
      const r = document.createRange();
      r.selectNodeContents(el);
      const rects = r.getClientRects();
      return rects[rects.length - 1]?.bottom ?? el.getBoundingClientRect().bottom;
    };
    mark.style.top = bottom(date) - bottom(mark.querySelector<HTMLElement>('.notes-mark-ja') ?? mark) + 'px';
    // the closing rule: level with the subscribe box's top rule
    const col = article.closest<HTMLElement>('main.column');
    const foot = col?.querySelector<HTMLElement>('.notes-foot');
    const sub = col?.querySelector<HTMLElement>('.sub');
    if (!col || !foot) return;
    if (!sub) return void (foot.hidden = true);
    foot.hidden = false;
    const c = col.getBoundingClientRect();
    foot.style.left = n.left - c.left + 'px';
    foot.style.width = n.width + 'px';
    foot.style.top = sub.getBoundingClientRect().top - c.top + col.scrollTop + 'px';
  }
  // The date's rule is drawn out of the flow: the body starts below it at the
  // distance set for each layout (表示設定 → 日付の下の線から本文まで; from
  // the date itself when there is no rule).
  function clearDateRule() {
    const head = document.querySelector<HTMLElement>('main.column .head');
    const date = head?.querySelector<HTMLElement>('.date');
    const body = document.querySelector<HTMLElement>('main.column .body');
    if (!head || !date || !body) return;
    head.style.marginBottom = '';
    const rule = getComputedStyle(date, '::after');
    const hasRule = parseFloat(rule.width) > 0;
    const [name, fallback] = matchMedia('(min-width: 1160px)').matches
      ? ['--s-rule-body', 56]
      : matchMedia('(min-width: 760px)').matches
        ? ['--s-rule-body-tab', 44]
        : ['--s-rule-body-sp', 40];
    const v = parseFloat(getComputedStyle(document.documentElement).getPropertyValue(name));
    const gap = Number.isFinite(v) ? v : fallback;
    const first = (body.firstElementChild as HTMLElement | null) ?? body;
    // (a margin: the head's min-height would swallow extra padding; margins
    // can collapse with the body's first one, so measure again and repeat)
    for (let i = 0; i < 6; i++) {
      const ruleY = hasRule ? date.getBoundingClientRect().top + parseFloat(rule.top) : date.getBoundingClientRect().bottom;
      const need = ruleY + gap - first.getBoundingClientRect().top;
      if (Math.abs(need) <= 0.5) break;
      head.style.marginBottom = parseFloat(getComputedStyle(head).marginBottom) + need + 'px';
    }
  }
  function layoutHead() {
    alignHead();
    clearDateRule();
    placeNotesHead();
  }
  layoutHead();
  document.fonts.ready.then(layoutHead);
  addEventListener('resize', layoutHead);
  addEventListener('load', layoutHead); // images and cards settled
</script>

<script>
  // Hover a number or note → highlight both. Click a number → smooth-scroll to
  // its counterpart inside the column, then keep it highlighted for 1.6s.
  // (The scroll moves the number out from under the cursor, which fires
  // mouseleave; that must not end the 1.6s highlight.)
  let timer: ReturnType<typeof setTimeout> | undefined;
  let jumping = false;
  const pair = (id: string) => document.querySelectorAll(`[data-note="${CSS.escape(id)}"]`);
  const setHl = (id: string | null) => {
    document.querySelectorAll('[data-note].is-hl').forEach((n) => n.classList.remove('is-hl'));
    if (id) pair(id).forEach((n) => n.classList.add('is-hl'));
  };
  const go = (targetId: string, id: string) => {
    let el = document.getElementById(targetId);
    // phones hide the sidenotes and show the list after the body instead
    if (el && !el.offsetParent) el = document.getElementById(`notes-${id}`) ?? el;
    if (el) {
      const r = el.getBoundingClientRect();
      const sc = el.closest<HTMLElement>('[data-scroll]');
      if (sc) {
        // the visible part of the column, without the margins inside it
        const cs = getComputedStyle(sc);
        const it = parseFloat(cs.getPropertyValue('--inset-top')) || 0;
        const ib = parseFloat(cs.getPropertyValue('--inset-bottom')) || 0;
        const sr = sc.getBoundingClientRect();
        const top = sr.top + it;
        const height = sr.height - it - ib;
        sc.scrollTo({ top: sc.scrollTop + r.top - top - height / 3, behavior: 'smooth' });
      } else {
        window.scrollTo({ top: window.scrollY + r.top - window.innerHeight / 3, behavior: 'smooth' });
      }
    }
    setHl(id);
    jumping = true;
    clearTimeout(timer);
    timer = setTimeout(() => {
      jumping = false;
      setHl(null);
    }, 1600);
  };

  // Phones (p5) have no hover highlight, only the jump.
  const phone = matchMedia('(max-width: 759px)');
  document.querySelectorAll<HTMLElement>('[data-note]').forEach((node) => {
    const id = node.dataset.note!;
    node.addEventListener('mouseenter', () => {
      if (phone.matches) return;
      clearTimeout(timer);
      jumping = false;
      setHl(id);
    });
    node.addEventListener('mouseleave', () => {
      if (phone.matches) return;
      if (!jumping) setHl(null);
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('.note-ref a, .note-num').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const target = a.getAttribute('href')!.slice(1);
      go(target, target.replace(/^(note|ref)-/, ''));
    });
  });
</script>
