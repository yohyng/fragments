---
import '../styles/tokens.css';
import '../styles/base.css';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import { settings, settingsStyle, fontsStylesheet, settingsSavedAt } from '../lib/settings';
// read by the admin (表示設定) to tell whether the site has caught up
const builtAt = new Date().toISOString();

type Props = SeoProps;
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja" data-welcome-off={settings.welcomeOn ? undefined : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- no icon in the design; an empty one stops the /favicon.ico 404 -->
    <link rel="icon" href="data:," />
    <meta name="fragments-build" content={builtAt} data-settings-saved={settingsSavedAt} />
    <Seo {...Astro.props} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // First page of a visit: keep it hidden until its web fonts have
      // arrived, so the stand-in face never shows and swaps (at most 3s).
      // Later pages: the Japanese fonts come in slices by character, and a new
      // article may need slices not loaded yet, so its column (not the index,
      // which stays put) waits for them too, briefly (at most 1.2s), and
      // fades in with the page transition.
      let fontsOk = false;
      try {
        fontsOk = sessionStorage.getItem('fragments-fonts') === '1';
      } catch {}
      if (fontsOk) {
        document.documentElement.classList.add('fonts-wait-pane');
        const showPane = () => document.documentElement.classList.remove('fonts-wait-pane');
        setTimeout(showPane, 1200);
        document.addEventListener('DOMContentLoaded', () =>
          requestAnimationFrame(() => (document.fonts.status === 'loaded' ? showPane() : document.fonts.ready.then(showPane))),
        );
      } else {
        document.documentElement.classList.add('fonts-wait');
        const showPage = () => document.documentElement.classList.remove('fonts-wait');
        setTimeout(showPage, 3000);
        document.addEventListener('DOMContentLoaded', () =>
          // after the first layout, so the fonts the page uses are loading
          requestAnimationFrame(() =>
            document.fonts.ready.then(() => {
              showPage();
              try {
                sessionStorage.setItem('fragments-fonts', '1');
              } catch {}
            }),
          ),
        );
      }
      // First visit to the top page: show the "fragments folio" overlay
      // (Welcome.astro). Decided here so the page never flashes first.
      try {
        if (
          location.pathname === '/' &&
          !document.documentElement.hasAttribute('data-welcome-off') &&
          localStorage.getItem('fragments-welcome') !== 'done'
        ) {
          document.documentElement.dataset.welcome = 'show';
        }
      } catch {}
      // The height actually visible (iPad browsers can lay the page out for
      // a taller area than they show). Unzoomed CSS px; kept up to date.
      const setFrameH = () => {
        const v = window.visualViewport;
        const h = v ? v.height * v.scale : window.innerHeight;
        document.documentElement.style.setProperty('--frame-h', Math.round(h) + 'px');
      };
      setFrameH();
      // iPad windows (Split View, Stage Manager) can be resized without the
      // visual viewport reporting it, so listen to the window too
      window.visualViewport?.addEventListener('resize', setFrameH);
      window.addEventListener('resize', setFrameH);
      window.addEventListener('orientationchange', setFrameH);
      window.addEventListener('pageshow', setFrameH);
      document.addEventListener('visibilitychange', setFrameH);
      // ?frame-debug: show the heights the browser reports (for iPad layouts)
      if (location.search.includes('frame-debug')) {
        addEventListener('load', () => {
          const box = document.createElement('pre');
          box.style.cssText =
            'position:fixed;z-index:99;left:8px;bottom:8px;margin:0;padding:8px 10px;background:#000c;color:#fff;font:12px/1.5 monospace;pointer-events:none';
          const probe = (h) => {
            const d = document.createElement('div');
            d.style.cssText = 'position:fixed;top:0;left:0;width:1px;visibility:hidden;height:' + h;
            document.body.append(d);
            const v = Math.round(d.getBoundingClientRect().height);
            d.remove();
            return v;
          };
          const show = () => {
            const v = window.visualViewport;
            const page = document.querySelector('.page');
            box.textContent = [
              'inner ' + innerWidth + '×' + innerHeight,
              'client ' + document.documentElement.clientWidth + '×' + document.documentElement.clientHeight,
              'visual ' + (v ? Math.round(v.width) + '×' + Math.round(v.height) + ' s' + v.scale.toFixed(2) + ' top' + Math.round(v.offsetTop) : '-'),
              'frame-h ' + getComputedStyle(document.documentElement).getPropertyValue('--frame-h'),
              'page ' + (page ? Math.round(page.getBoundingClientRect().height) : '-'),
              'dvh ' + probe('100dvh') + ' svh ' + probe('100svh') + ' lvh ' + probe('100lvh') + ' fixed ' + probe('100%'),
              'screen ' + screen.width + '×' + screen.height + ' dpr ' + devicePixelRatio,
              'coarse ' + matchMedia('(pointer: coarse)').matches,
            ].join('\n');
          };
          document.body.append(box);
          show();
          addEventListener('resize', show);
          window.visualViewport?.addEventListener('resize', show);
        });
      }
      // A swipe that starts outside every column (gaps, margins) must not
      // drag the page. A column pulled down past its top must not bounce
      // (that would drag the sticky header down and show the space above);
      // at the bottom it may.
      // Direction comes from the previous touch point, not the first one.
      let lastX = 0;
      let lastY = 0;
      document.addEventListener(
        'touchstart',
        (e) => {
          lastX = e.touches[0].clientX;
          lastY = e.touches[0].clientY;
        },
        { passive: true },
      );
      document.addEventListener(
        'touchmove',
        (e) => {
          if (e.touches.length > 1) return; // pinch-zoom stays free
          const col = e.target instanceof Element ? e.target.closest('[data-scroll], [data-welcome]') : null;
          if (!col) return e.preventDefault();
          const { clientX: x, clientY: y } = e.touches[0];
          const dx = x - lastX;
          const dy = y - lastY;
          lastX = x;
          lastY = y;
          if (dy > 0 && dy > Math.abs(dx) && col.scrollTop <= 0) e.preventDefault();
        },
        { passive: false },
      );
      // Pull to refresh: the page never scrolls, so the browser's own never
      // fires. A column pulled down at its top shows ↻ coming down from the
      // top edge; let go past the mark, and the page reloads.
      (() => {
        const MARK = 64; // px of pull (after damping) to reload
        let col = null;
        let startY = 0;
        let pull = 0;
        let el = null;
        const ui = () => {
          if (el) return el;
          el = document.createElement('div');
          el.className = 'ptr';
          el.setAttribute('aria-hidden', 'true');
          el.innerHTML =
            '<svg viewBox="0 0 24 24"><path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3" /><path d="M19.5 4.5v4h-4" /></svg>';
          document.body.append(el);
          return el;
        };
        const draw = () => {
          const n = ui();
          const p = Math.min(pull / MARK, 1);
          n.style.transition = 'none';
          n.style.opacity = String(Math.min(1, pull / 24));
          n.style.transform = 'translate(-50%, ' + (Math.min(pull, MARK * 1.4) - 44) + 'px) rotate(' + p * 270 + 'deg)';
          n.classList.toggle('is-ready', pull >= MARK);
        };
        const reset = () => {
          if (!el) return;
          el.style.transition = '';
          el.style.opacity = '0';
          el.style.transform = 'translate(-50%, -44px)';
          el.classList.remove('is-ready');
        };
        document.addEventListener(
          'touchstart',
          (e) => {
            pull = 0;
            const c = e.touches.length === 1 && e.target instanceof Element ? e.target.closest('[data-scroll]') : null;
            col = c && c.scrollTop <= 0 && !document.documentElement.dataset.welcome ? c : null;
            startY = e.touches[0].clientY;
          },
          { passive: true },
        );
        document.addEventListener(
          'touchmove',
          (e) => {
            if (!col) return;
            if (e.touches.length > 1 || col.scrollTop > 0) {
              col = null;
              pull = 0;
              return reset();
            }
            pull = Math.max(0, (e.touches[0].clientY - startY) * 0.5);
            draw();
          },
          { passive: true },
        );
        const end = () => {
          if (!col) return;
          col = null;
          if (pull >= MARK && el) {
            el.style.transition = '';
            el.style.transform = 'translate(-50%, ' + (MARK - 44) + 'px)';
            el.classList.add('is-loading');
            location.reload();
          } else reset();
          pull = 0;
        };
        document.addEventListener('touchend', end, { passive: true });
        document.addEventListener('touchcancel', () => ((pull = 0), end()), { passive: true });
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsStylesheet} />
    {settingsStyle && <style is:inline data-settings set:html={settingsStyle} />}
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/scroll';
    </script>
  </body>
</html>
