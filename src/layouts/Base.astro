---
import '../styles/tokens.css';
import '../styles/base.css';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import { settings, settingsStyle, fontsStylesheet } from '../lib/settings';

type Props = SeoProps;
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja" data-welcome-off={settings.welcomeOn ? undefined : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- no icon in the design; an empty one stops the /favicon.ico 404 -->
    <link rel="icon" href="data:," />
    <Seo {...Astro.props} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // First page of a visit: keep it hidden until its web fonts have
      // arrived, so the stand-in face never shows and swaps (at most 3s).
      // Later pages: the Japanese fonts come in slices by character, and a new
      // article may need slices not loaded yet, so its column (not the index,
      // which stays put) waits for them too, briefly (at most 1.2s), and
      // fades in with the page transition.
      let fontsOk = false;
      try {
        fontsOk = sessionStorage.getItem('fragments-fonts') === '1';
      } catch {}
      if (fontsOk) {
        document.documentElement.classList.add('fonts-wait-pane');
        const showPane = () => document.documentElement.classList.remove('fonts-wait-pane');
        setTimeout(showPane, 1200);
        document.addEventListener('DOMContentLoaded', () =>
          requestAnimationFrame(() => (document.fonts.status === 'loaded' ? showPane() : document.fonts.ready.then(showPane))),
        );
      } else {
        document.documentElement.classList.add('fonts-wait');
        const showPage = () => document.documentElement.classList.remove('fonts-wait');
        setTimeout(showPage, 3000);
        document.addEventListener('DOMContentLoaded', () =>
          // after the first layout, so the fonts the page uses are loading
          requestAnimationFrame(() =>
            document.fonts.ready.then(() => {
              showPage();
              try {
                sessionStorage.setItem('fragments-fonts', '1');
              } catch {}
            }),
          ),
        );
      }
      // First visit to the top page: show the "fragments folio" overlay
      // (Welcome.astro). Decided here so the page never flashes first.
      try {
        if (
          location.pathname === '/' &&
          !document.documentElement.hasAttribute('data-welcome-off') &&
          localStorage.getItem('fragments-welcome') !== 'done'
        ) {
          document.documentElement.dataset.welcome = 'show';
        }
      } catch {}
      // The height actually visible (iPad browsers can lay the page out for
      // a taller area than they show). Unzoomed CSS px; kept up to date.
      const setFrameH = () => {
        const v = window.visualViewport;
        const h = v ? v.height * v.scale : window.innerHeight;
        document.documentElement.style.setProperty('--frame-h', Math.round(h) + 'px');
      };
      setFrameH();
      (window.visualViewport || window).addEventListener('resize', setFrameH);
      window.addEventListener('orientationchange', setFrameH);
      // A swipe that starts outside every column (gaps, margins) must not
      // drag the page. A column pulled down past its top must not bounce
      // (that would drag the sticky header down and show the space above);
      // at the bottom it may.
      // Direction comes from the previous touch point, not the first one.
      let lastX = 0;
      let lastY = 0;
      document.addEventListener(
        'touchstart',
        (e) => {
          lastX = e.touches[0].clientX;
          lastY = e.touches[0].clientY;
        },
        { passive: true },
      );
      document.addEventListener(
        'touchmove',
        (e) => {
          if (e.touches.length > 1) return; // pinch-zoom stays free
          const col = e.target instanceof Element ? e.target.closest('[data-scroll], [data-welcome]') : null;
          if (!col) return e.preventDefault();
          const { clientX: x, clientY: y } = e.touches[0];
          const dx = x - lastX;
          const dy = y - lastY;
          lastX = x;
          lastY = y;
          if (dy > 0 && dy > Math.abs(dx) && col.scrollTop <= 0) e.preventDefault();
        },
        { passive: false },
      );
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsStylesheet} />
    {settingsStyle && <style is:inline data-settings set:html={settingsStyle} />}
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/scroll';
    </script>
  </body>
</html>
