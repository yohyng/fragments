---
import '../styles/tokens.css';
import '../styles/base.css';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';

type Props = SeoProps;
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>{title}</title>
    <!-- no icon in the design; an empty one stops the /favicon.ico 404 -->
    <link rel="icon" href="data:," />
    <Seo {...Astro.props} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // iOS Safari ignores user-scalable=no: stop its pinch gesture directly.
      ['gesturestart', 'gesturechange'].forEach((t) =>
        document.addEventListener(t, (e) => e.preventDefault(), { passive: false }),
      );
      // A swipe that starts outside every column (gaps, margins) must not
      // drag the page.
      document.addEventListener(
        'touchmove',
        (e) => {
          if (!(e.target instanceof Element && e.target.closest('[data-scroll]'))) e.preventDefault();
        },
        { passive: false },
      );
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond&family=Lora:ital@0;1&family=Shippori+Mincho:wght@400;500&family=Zen+Old+Mincho&display=swap"
    />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/scroll';
    </script>
  </body>
</html>
