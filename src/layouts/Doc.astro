---
// A page of text beside the index (privacy policy, terms of use): the about
// page's layout — heading, the light rule level with the index's, the text
// where the body goes and an aside where the notes go.
import Page from './Page.astro';
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---


<Page title={`${title} — ${site.name}`} description={description}>
  <main class="column" data-scroll data-noscrollbar>
    <div class="rule"><a class="site" href="/">fragments</a></div>
    <div class="grid">
      <header class="head">
        <h1>{title}</h1>
      </header>
      <div class="text doc">
        <slot />
      </div>
      <div class="side">
        <slot name="side" />
      </div>
    </div>
    <div class="end-space"></div>
    <div class="endrule" data-endrule></div>
    <div class="scroll-foot" aria-hidden="true"></div>
  </main>
</Page>

<script>
  // Beside the index (≥1160px): the rule under the heading level with the
  // light rule under the index's catch copy.
  function alignRule() {
    const col = document.querySelector<HTMLElement>('main.column');
    const head = col?.querySelector<HTMLElement>('.head');
    const index = document.querySelector<HTMLElement>('[data-index]');
    const en = index?.querySelector<HTMLElement>('.intro-en');
    if (!col || !head || !en) return;
    head.style.minHeight = '';
    if (!matchMedia('(min-width: 1160px)').matches || !en.offsetParent) return;
    // the index's rule: the catch copy's ::after, `top` below the copy's box
    const ruleY = en.getBoundingClientRect().top + parseFloat(getComputedStyle(en, '::after').top) + index!.scrollTop;
    const headTop = head.getBoundingClientRect().top + col.scrollTop;
    // the head's bottom border is the rule (border-box: its top edge is at height − 1)
    head.style.minHeight = Math.max(0, ruleY - headTop + 1) + 'px';
  }
  alignRule();
  document.fonts.ready.then(alignRule);
  addEventListener('resize', alignRule);
</script>

<style>
  .column {
    height: 100%;
    overflow-y: auto;
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
  }
  .rule {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-bg);
    height: calc(var(--s-site-name, 30) * 1.2px); /* the index site name's line (36px by default) */
    padding-bottom: 6px;
    box-sizing: content-box;
    border-bottom: 1px solid var(--color-neutral-700);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 56px;
    min-height: 220px;
    box-sizing: border-box;
    /* across the text and the contact, a light rule; the text below it */
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--color-divider);
    margin-bottom: 40px;
  }
  h1 {
    font-family: var(--font-mincho-heading);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 34em) 300px;
    column-gap: 88px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: clamp(15px, 0.8rem + 0.2vw, 16px);
    line-height: 1.9;
  }
  .text.doc {
    gap: 12px;
    font-size: clamp(14px, 0.78rem + 0.15vw, 15px);
  }
  .doc :global(h2) {
    margin: 1.4em 0 0;
    font-family: var(--font-mincho-heading);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.7;
  }
  .doc :global(h2:first-child) {
    margin-top: 0;
  }
  .doc :global(p),
  .doc :global(ul) {
    margin: 0;
    font-family: var(--font-mincho);
    text-align: justify;
    color: var(--color-neutral-800);
  }
  .doc :global(ul) {
    padding-left: 1.4em;
  }
  .doc :global(.updated) {
    margin-top: 1.6em;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-neutral-700);
  }
  .side :global(a) {
    display: block;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: var(--font-mincho);
    font-size: 12px;
    line-height: 1.75;
    color: var(--color-neutral-800);
  }
  .contact {
    display: flex;
    flex-direction: column;
  }
  .label {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-neutral-700);
  }
  .end-space {
    min-height: 96px;
    flex: 1 0 96px;
  }
  .endrule {
    flex: none;
    position: sticky;
    bottom: 0;
    height: 0;
    border-top: 1px solid var(--color-neutral-700);
  }
  /* always shown on this page */
  .endrule[data-endrule] {
    opacity: 1;
  }
  .site {
    display: none;
  }

  /* Compact 3 columns, narrow end: contact in the 210px note position
     (from 1300px the PC grid fits; its text column gives way) */
  @media (min-width: 1160px) and (max-width: 1299px) {
    .grid {
      grid-template-columns: minmax(0, calc(30 * clamp(15px, 0.8rem + 0.2vw, 16px))) 210px;
      column-gap: 40px;
    }
  }

  /* Not in the design: follows the tablet / phone article (p6 / p5) —
     site name in the header, contact where the notes go (tablet) or
     after the text (phone). */
  @media (max-width: 1159px) {
    .column {
      padding: 0 var(--inset-x);
    }
    .endrule {
      bottom: var(--inset-bottom);
    }
    .rule {
      padding-top: var(--inset-top);
      z-index: 2;
      height: auto;
      box-sizing: border-box;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .site {
      display: block;
      font-family: var(--font-heading);
      font-size: calc(var(--s-site-name, 30) * 28px / 30); /* as on the other pages */
      line-height: 1.2;
      text-decoration: none;
    }
    .site,
    .site:hover {
      color: var(--color-text);
    }
    .head {
      min-height: 0;
      padding: 56px 0 40px;
    }
    .grid {
      grid-template-columns: minmax(0, 465px) 210px;
      column-gap: 40px;
    }
    .text {
      font-size: 15.5px;
    }
    .end-space {
      min-height: 80px;
      flex-basis: 80px;
    }
  }
  @media (max-width: 759px) {
    .rule {
      z-index: 1;
      display: block;
    }
    .site {
      font-size: calc(var(--s-site-name-sp, var(--s-site-name, 30) * 26 / 30) * 1px); /* as on the top page */
    }
    .head {
      padding: 40px 0 36px;
      margin-bottom: 0; /* the grid's row gap */
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
    }
    .end-space {
      min-height: 48px;
      flex-basis: 48px;
    }
  }
</style>
